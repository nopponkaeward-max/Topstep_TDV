//@version=6
// ============================================================================
// RENKO ENGULF v6  — ใช้บนชาร์ต Renko ของ TradingView (Chart type → Renko)
//   BUY  : แท่ง Renko Bullish ที่ High-Low ครอบคลุมแท่ง Bullish ก่อนหน้า → Exit เมื่อเจอแท่ง Bearish
//   SELL : เงื่อนไขตรงข้าม (Bearish ครอบคลุม Bearish ก่อนหน้า)          → Exit เมื่อเจอแท่ง Bullish
//   Visual / ตาราง Stats อิงจาก NOPPON-GOLD1-1 (Luxe theme, Stats / Monthly / Weekday / Daily / Settings)
//   1R = ระยะ 2 box จากราคาเข้า (2 × ขนาด box = 2 × |close-open| ของ brick ที่เข้า) ไม่ใช้ High-Low ของ brick
// ============================================================================

indicator("RENKO-ENGULF-v6", shorttitle="RNK-ENGREV", overlay=true, max_lines_count=500, max_labels_count=500)

// ==========================================
// --- 1. INPUTS ---
// ==========================================
// ---------- ENTRY  (เงื่อนไขเข้า) ----------
entryMode  = input.string("Engulf", "Entry mode", options=["Engulf", "Reversal", "NoWick Reversal", "Engulf + Reversal", "Engulf + NoWick", "Reversal + NoWick", "All (Engulf + Reversal + NoWick)", "W&M", "Reverse Engulf", "Double Bottom/Top (3-2-2-3)", "FollowTrend", "RevEngulf02", "RGR", "All + Pattern"], group="Entry Strategy", display=display.none,
     tooltip="Engulf = เข้าเมื่อแท่งสีเดียวกันครอบ High-Low ของแท่งก่อนหน้า (แบบเดิม)\nReversal = Buy: มีแท่งแดงติดกันก่อนหน้า >= N แท่ง แล้วเกิดแท่งเขียวที่ High สูงกว่า และ Low ต่ำกว่าแท่งแดงล่าสุด / Sell: ตรงข้าม\nNoWick Reversal = Buy: มีแท่งแดงติดกัน >= N แท่ง แล้วเกิดแท่งเขียว โดย 'แท่งแดงที่ติดกับแท่งเขียว' และ 'แท่งเขียวที่เกิด' ต้อง **ไม่มีไส้ (no wick)** ทั้งคู่ (แท่งอื่นมีไส้ได้) / Sell: ตรงข้าม\nแบบที่มี + = ใช้หลายเงื่อนไขร่วมกัน ข้อไหนเกิดก่อนก็เข้า\nW&M = Sell: แดง >= N แท่ง > เขียว 1 > แดง 1 > เขียว 1 > แดง 1 (เข้าที่แท่งแดงสุดท้าย) / Buy: สลับสี (เขียว N > แดง > เขียว > แดง > เขียว)\nReverse Engulf = Buy: เขียว > แดงที่ High-Low คลุมแท่งเขียวแรก > เขียว 2 แท่ง (เข้าที่เขียวแท่งที่ 2) / Sell: สลับสี\nDouble = Buy: แดง >= 3 > เขียว 2 > แดง 2 > เขียว 3 (เข้าที่เขียวแท่งที่ 3) / Sell: สลับสี (เขียว >= 3 > แดง 2 > เขียว 2 > แดง 3)\nFollowTrend = Sell: แดง >= 3 > เขียว 2 > แดง 1 > เขียว 1 > แดง 1 (เข้าที่แดงสุดท้าย) / Buy: สลับสี\nRevEngulf02 = Buy: แดงไม่มีไส้ > แดงที่ High-Low คลุมแท่งแรกทั้งหมด > เขียวที่ Low ต่ำกว่า Low ของแดงก่อนหน้า / Sell: สลับสี (เขียวไม่มีไส้ > เขียวคลุม > แดงที่ High สูงกว่า High ของเขียวก่อนหน้า)\nRGR = Sell: แดง > เขียว > แดง (เข้าที่แดงแท่งสุดท้าย) / Buy: เขียว > แดง > เขียว (เข้าที่เขียวแท่งสุดท้าย) นับ 3 แท่งล่าสุดตามสี ไม่จำกัดจำนวนแท่งก่อนหน้า\nExit / TP / SL ใช้ค่าเดิมทุกโหมด")
revMin     = input.int(4, "Reversal: จำนวนแท่งสีตรงข้ามติดกันขั้นต่ำ (N) — ใช้เมื่อ Entry mode มี Reversal", minval=1, maxval=50, group="Entry Strategy", display=display.none)
nwMin      = input.int(4, "NoWick Reversal: จำนวนแท่งสีตรงข้ามติดกันขั้นต่ำ (N) — ใช้เมื่อ Entry mode มี NoWick", minval=1, maxval=50, group="Entry Strategy", display=display.none)
patMin     = input.int(3, "W&M: จำนวนแท่งสีเดียวกันติดกันขั้นต่ำก่อนเริ่มรูปแบบ (N) — ใช้เมื่อ Entry mode เป็น W&M", minval=1, maxval=50, group="Entry Strategy", display=display.none)
nwTol      = input.float(0.0, "NoWick: ไส้ที่ยอมรับได้ (หน่วยราคา) 0 = ไม่มีไส้เลย", minval=0.0, step=0.01, group="Entry Strategy", display=display.none,
     tooltip="แท่ง no wick = High เท่ากับด้านบนของตัวแท่ง และ Low เท่ากับด้านล่างของตัวแท่ง (บนกราฟ Renko ของ TradingView แท่งขึ้นมีไส้ล่าง / แท่งลงมีไส้บน)\nใส่ค่ามากกว่า 0 ถ้าอยากยอมให้มีไส้เล็กน้อย")
prevModeIn = input.string("Immediate previous bar", "Compare with previous", options=["Immediate previous bar", "Last Bull/Bear"], group="Entry Strategy", display=display.none,
     tooltip="Immediate previous bar = แท่งก่อนหน้าทันทีต้องเป็นสีเดียวกัน แล้วแท่งปัจจุบันคลุม High-Low ของมัน\nLast Bull/Bear = (แบบเดิม) เทียบกับแท่งสีเดียวกันล่าสุด ข้ามแท่งสีตรงข้ามที่คั่นอยู่")
tol        = input.float(0.0, "Tolerance (price)", minval=0.0, step=0.01, group="Entry Strategy", display=display.none, tooltip="ยอมให้ High/Low ของแท่งพลาดจากแท่งก่อนหน้าได้ไม่เกินค่านี้")
allowLong  = input.bool(true, "Enable Buy",  group="Entry Strategy", display=display.none)
allowShort = input.bool(true, "Enable Sell", group="Entry Strategy", display=display.none)
oneOrderOnly = input.bool(true, "One order at a time (เปิดได้ครั้งละ 1 ออเดอร์)", group="Entry Strategy", display=display.none,
     tooltip="เปิด = ถือได้ครั้งละ 1 ออเดอร์ สัญญาณใหม่ระหว่างถืออยู่จะถูกข้าม\nปิด = เจอสัญญาณทิศเดียวกันซ้ำจะเปิดออเดอร์เพิ่ม (ซ้อนไม้) แล้วปิดทั้งหมดเมื่อเจอแท่งตรงข้าม")

// ---------- EXIT  (เงื่อนไขออก) ----------
exitMode   = input.string("Opposite brick", "Exit mode (เลือกใช้อย่างใดอย่างหนึ่งเท่านั้น)", options=["Opposite brick", "N same-color boxes", "TP / SL (price distance)"], group="Exit Strategy", display=display.none,
     tooltip="เลือกได้อย่างเดียว ไม่ใช้ร่วมกัน:\n1. Opposite brick = ออกเมื่อเจอ box สีตรงข้ามกับทิศที่ถือ\n2. N same-color boxes = ออกเมื่อมี box สีเดียวกับทิศที่ถือครบ N แท่ง (ช่อง N ด้านล่าง) ไม่มี stop ระหว่างรอ ระวัง\n3. TP / SL (price distance) = ออกเมื่อราคาไปถึง TP หรือ SL ที่ระยะห่างจากราคาเข้า เป็นหน่วยราคาของสินทรัพย์ (ช่อง TP / SL ด้านล่าง)")
exitN      = input.int(3, "[โหมด 2] N = จำนวน box สีเดียวกับทิศออเดอร์", minval=1, maxval=50, group="Exit Strategy", display=display.none,
     tooltip="ใช้เมื่อ Exit mode = N same-color boxes\nBuy: นับ box ขาขึ้น / Sell: นับ box ขาลง ออกที่แท่งที่ N (นับสะสม ไม่ต้องติดกัน)")
countEntry = input.bool(false, "[โหมด 2] นับ box ที่เข้าออเดอร์เป็น box ที่ 1", group="Exit Strategy", display=display.none,
     tooltip="ปิด = เริ่มนับจากแท่งถัดจากแท่งที่เข้า (N=3 → ออกที่แท่งที่ 3 หลังเข้า)\nเปิด = แท่งที่เข้านับเป็น 1 (N=3 → ออกที่แท่งที่ 2 หลังเข้า)")
tpPts      = input.float(5.0, "[โหมด 3] TP ระยะราคา (0 = ไม่ใช้)", minval=0.0, step=0.5, group="Exit Strategy", display=display.none,
     tooltip="ใช้เมื่อ Exit mode = TP / SL\nระยะห่างจากราคาเข้าเป็นหน่วยราคาของสินทรัพย์ (นับที่หลักหน่วย) เช่น ทองเข้า Buy ที่ 4200.5 ใส่ TP 5 → ออกที่ 4205.5 (Sell: 4195.5)\nตรวจจาก High/Low ของ brick (รวมไส้) ที่ปิดแล้ว ผลสถิติคิดที่ระดับ TP พอดี\nต้องตั้ง TP ใน TopstepX ให้เท่ากันเพื่อให้โบรกเกอร์ออกทันที")
slPts      = input.float(5.0, "[โหมด 3] SL ระยะราคา (0 = ไม่ใช้)", minval=0.0, step=0.5, group="Exit Strategy", display=display.none,
     tooltip="ใช้เมื่อ Exit mode = TP / SL\nระยะห่างจากราคาเข้าเป็นหน่วยราคาของสินทรัพย์ เช่น ทองเข้า Buy ที่ 4200.5 ใส่ SL 5 → ออกที่ 4195.5 (Sell: 4205.5)\nSL คงที่จากราคาเข้า ไม่เลื่อนตามราคา / ถ้าใน brick เดียวแตะทั้ง TP และ SL ถือว่า SL ก่อน\nถ้า SL = 0 และ TP = 0 จะไม่มีเงื่อนไขออกเลย ระวัง")

// ---------- TRADING HOURS  (งดเทรด UTC+7) ----------
tfEnable   = input.bool(false, "เปิดตัวกรองช่วงเวลางดเทรด (UTC+7)", group="Trading Hours (UTC+7)", display=display.none,
     tooltip="เปิด = ไม่เปิดออเดอร์ใหม่ในช่วงเวลาที่กำหนดด้านล่าง (เวลาไทย UTC+7)\nการออกจากออเดอร์ที่เปิดอยู่ยังทำงานตามปกติแม้อยู่ในช่วงงดเทรด\nใช้กับสถิติย้อนหลังด้วย (สัญญาณในช่วงงดเทรดจะไม่ถูกนับ)")
tfSess1    = input.session("0400-0600", "ช่วงงดเทรด 1 (HHMM-HHMM เวลาไทย)", group="Trading Hours (UTC+7)", display=display.none,
     tooltip="รูปแบบ HHMM-HHMM เช่น 0400-0600 (ช่วงพักตลาด CME ประมาณ 04:00-05:00 หรือ 05:00-06:00 เวลาไทย ตามฤดูกาล) ข้ามเที่ยงคืนได้ เช่น 2300-0100\nเวลาเริ่ม = รวม / เวลาสิ้นสุด = ไม่รวม / ถ้าเวลาเริ่มเท่ากับสิ้นสุด (เช่น 0000-0000) = ไม่ใช้ช่วงนี้")
tfSess2    = input.session("0000-0000", "ช่วงงดเทรด 2 (0000-0000 = ไม่ใช้)", group="Trading Hours (UTC+7)", display=display.none)
tfSess3    = input.session("0000-0000", "ช่วงงดเทรด 3 (0000-0000 = ไม่ใช้)", group="Trading Hours (UTC+7)", display=display.none)
showTfBg   = input.bool(true, "แรเงาแท่งในช่วงงดเทรด", group="Trading Hours (UTC+7)", display=display.none)

// ---------- WEBHOOK: เลือกรูปแบบข้อความ Alert ----------
whMode     = input.string("TopstepX Clicker", "Alert mode (Any alert() function call)", options=["Text only (pop-up)", "OKX Signal Bot", "TopstepX Clicker"], group="Webhook · Alert Mode", display=display.none,
     tooltip="ใช้กับ Alert ที่เลือก Condition = 'Any alert() function call'\nText only = ข้อความอ่านง่ายสำหรับ pop-up/มือถือ/อีเมล (ไม่ส่งอะไรเข้า OKX)\nOKX Signal Bot = JSON สำหรับ OKX Signal Bot (ไม่ต้องมีเซิร์ฟเวอร์) ขนาดตามช่อง OKX amount (หรือใช้ค่าของ Bot ถ้าเลือก Bot setting) ปิดด้วย EXIT 100% ของ position ในบอท\nTopstepX Clicker = JSON สำหรับบอทคลิก TopstepX บน PC/Mac (บังคับใช้ Immediate previous bar และ One order at a time)")

// ---------- WEBHOOK: TopstepX  (บอทกดคีย์ลัดบนเครื่อง) ----------
whSecret   = input.string("CHANGE_ME", "Webhook secret (โหมด TopstepX Clicker)", group="Webhook · TopstepX", display=display.none, tooltip="ต้องตรงกับ secret ใน bot/config.json")
testSend   = input.bool(false, "ส่งสัญญาณทดสอบไปบอท (ใช้ตอนสร้าง Alert ทดสอบเท่านั้น)", group="Webhook · TopstepX", display=display.none,
     tooltip="เฉพาะโหมด TopstepX Clicker: เมื่อเปิด จะส่งสัญญาณทดสอบ 1 ครั้งทันทีที่สคริปต์/Alert เริ่มทำงานแบบ realtime เพื่อเช็กสายส่ง TradingView → Webhook → บอท\nอย่าเปิดไว้ใน Alert จริง! ให้สร้าง Alert ทดสอบแยก แล้วลบทิ้งหลังทดสอบ (ถ้าบอท dry_run=false บอทจะกดคีย์จริง)")
testAct    = input.string("buy", "ทดสอบ action", options=["buy", "sell"], group="Webhook · TopstepX", display=display.none)

// ---------- WEBHOOK: OKX Signal Bot ----------
whSignalToken = input.string("", "OKX signalToken (โหมด OKX Signal Bot)", group="Webhook · OKX", display=display.none, tooltip="คัดลอกจากหน้าสร้าง Signal ใน OKX")
whInstId   = input.string("BTCUSDT.P", "OKX instrument", group="Webhook · OKX", display=display.none, tooltip="ชื่อสัญญาที่ส่งให้ OKX รูปแบบเดียวกับ {{ticker}} ของ TradingView เช่น BTCUSDT.P, HBARUSDT.P (ใช้ทั้งตอนเข้าและตอนปิด)\nต้องมีบอทบน OKX ของสัญญานั้น (1 บอทต่อ 1 สัญญา) และตรงกับ signalToken")
okxGapMs   = input.int(1000, "OKX หน่วง ENTER หลัง EXIT (ms) ตอนกลับทิศ", minval=0, maxval=10000, step=100, group="Webhook · OKX", display=display.none, tooltip="เมื่อ brick เดียวต้องปิดแล้วเปิดกลับทิศ: ส่ง EXIT ทันที แล้วรอให้ครบเวลานี้ค่อยส่ง ENTER (ส่งในการรันสคริปต์ครั้งถัดไปหลังครบเวลา ซึ่งต้องมี tick เข้ามา) กัน ENTER ไปถึง OKX ก่อน EXIT แล้วถูกปิดทิ้ง\n0 = ส่งพร้อมกันแบบเดิม")
okxMaxLag  = input.int(120, "OKX Max Lag (วินาที)", minval=1, maxval=3600, group="Webhook · OKX", display=display.none, tooltip="ถ้า alert ถึง OKX ช้ากว่านี้ OKX จะยกเลิกสัญญาณ (ค่าเริ่มต้น 120 วินาที)")
okxSizeMode = input.string("contract", "OKX ขนาดออเดอร์ที่ส่งตอนเข้า (โหมด OKX Signal Bot)", options=["Bot setting", "contract", "margin", "percentage_balance", "percentage_investment"], group="Webhook · OKX", display=display.none,
     tooltip="Bot setting = ไม่ส่งขนาดไปกับสัญญาณ ใช้ขนาดที่ตั้งในหน้า Signal Bot ของ OKX (ถ้า Bot ไม่ได้ตั้ง OKX จะใช้ค่าเริ่มต้น = 100% ของยอดคงเหลือ (Bot คู่เดียว) หรือ 50% (Bot หลายคู่) ต่อการเข้า!)\ncontract = จำนวนสัญญา (จำนวนเต็ม) / margin = มาร์จิ้นเป็นจำนวนเงิน / percentage_balance = % ของยอดคงเหลือ / percentage_investment = % ของเงินลงทุนของ Bot\nหมายเหตุ: ถ้าทั้ง Bot และสัญญาณกำหนดขนาด OKX ใช้ค่าของ Bot ก่อน\nขาออกไม่ส่งขนาด (OKX ปิด 100% ของสถานะที่เปิดอยู่)")
okxAmount  = input.float(1.0, "OKX amount (ตามชนิดที่เลือกด้านบน)", minval=0.0001, step=0.1, group="Webhook · OKX", display=display.none,
     tooltip="contract: จำนวน contract (ทศนิยมได้ตาม step ของสัญญานั้น เช่น 0.1) / margin: จำนวนเงินบวก / percentage_*: 0.01–100\nไม่ใช้เมื่อเลือก Bot setting")

// ---------- DISPLAY  (การแสดงผลบนกราฟ) ----------
showTradePath  = input.bool(true, "Show Trade Path Lines (เส้นโยงเปิด→ปิด)", group="Display", display=display.none)
showEntryLine  = input.bool(true, "Show Entry Price Line + Label", group="Display", display=display.none)
showTickLine = input.bool(true, "แสดงเส้นแนวตั้งสีทอง High-Low ของ brick ที่กำลังก่อตัว (ถัดจากแท่งล่าสุด)", group="Display", display=display.none,
     tooltip="ยอดราคาสูง/ต่ำสุดที่วิ่งไปถึงตั้งแต่ brick ล่าสุดปิด (นับจาก tick สดตั้งแต่เปิดกราฟ) วาดเป็นเส้นแนวตั้งที่ช่องถัดจากแท่งล่าสุด")
colTick      = input.color(color.new(#fbbf24, 0), "สีเส้น High-Low ของ brick ที่กำลังก่อตัว", group="Display", display=display.none)
showBg         = input.bool(true, "Highlight bars in position", group="Display", display=display.none)
orderLabelSizeStr   = input.string("Small", "Order Label Size", options=["Tiny","Small","Normal","Large","Huge"], group="Display", display=display.none)

// ---------- STATS: ช่วงเวลาที่ดูสถิติ ----------
statMode    = input.string("2. ย้อนหลังตามจำนวนเดือน (Months)", "▶ เลือกโหมดดูสถิติ", options=["0. วันนี้ (Today)", "1. ย้อนหลังตามจำนวนวัน (Days)", "2. ย้อนหลังตามจำนวนเดือน (Months)", "3. เจาะจงเดือนและปี (Specific Month)", "4. เลือกวันที่จากปฏิทิน (Pick Date)"], group="Stats · Period", display=display.none,
     tooltip="0. วันนี้ = นับเฉพาะออเดอร์ที่เปิดในวันนี้ (ตามเวลา UTC +/- ด้านล่าง) และแสดงตารางรายออเดอร์ของวันนี้\n4. เลือกวันที่จากปฏิทิน = นับเฉพาะออเดอร์ที่เปิดในวันที่เลือกที่ช่อง [โหมด 4] และแสดงตารางรายออเดอร์ของวันนั้น")
statDays    = input.int(30, "[โหมด 1] ย้อนหลัง (วัน)", minval=1, maxval=365, group="Stats · Period", display=display.none)
statMonths  = input.int(9, "[โหมด 2] ย้อนหลัง (เดือน) [1-12]", minval=1, maxval=12, group="Stats · Period", display=display.none)
statTargetM = input.string("August", "[โหมด 3] ระบุเดือน", options=["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"], group="Stats · Period", display=display.none)
statTargetY = input.int(0, "[โหมด 3] ระบุปี (0 = ปีปัจจุบัน)", minval=0, maxval=2100, group="Stats · Period", display=display.none)
// ค่าเริ่มต้นเป็นเลข epoch มิลลิวินาที (const) = 13 Oct 2026 12:00 (UTC+7); timestamp() ใน v6 ได้ชนิด simple ใช้เป็น defval ไม่ได้
statPickDate = input.time(1791867600000, "[โหมด 4] เลือกวันที่ (ปฏิทิน)", group="Stats · Period", display=display.none,
     tooltip="กดช่องนี้เพื่อเลือกวันที่จากปฏิทิน (ใช้เฉพาะวันที่ ไม่สนเวลา) ต้องตั้ง UTC (+/-) ด้านล่างให้ตรงกับ timezone ของกราฟ\nดูย้อนหลังได้เท่าที่ TradingView โหลดประวัติกราฟไว้")
statsTzIncr = input.int(7, "UTC (+/-) สำหรับตัดวันของตาราง", minval=-12, maxval=14, group="Stats · Period", display=display.none, tooltip="ตั้งให้ตรงกับ timezone ของกราฟ (ไทย = +7)")

// ---------- STATS: ตารางและตำแหน่ง ----------
showStatsTable = input.bool(true, "Show Stats Table", group="Stats · Tables", display=display.none)
showDailyTable   = input.bool(false, "Show Daily Stats Table (รายวันของเดือน)", group="Stats · Tables", display=display.none)
showMonthlyTable = input.bool(true, "Show Monthly Stats Table (สรุปรายเดือน)", group="Stats · Tables", display=display.none)
showWeekdayTable = input.bool(true, "Show Weekday Stats (Sun-Sat)", group="Stats · Tables", display=display.none,
     tooltip="inW / inL = streak ชนะ/แพ้ที่ยาวสุด แยกตามวันในสัปดาห์\n🔥 = วันที่มีส่วนใน max loss streak มากสุด")
showTodayTable = input.bool(false, "Show Day Trades Table (รายออเดอร์ของวันที่เลือก/วันนี้)", group="Stats · Tables", display=display.none,
     tooltip="แสดงตารางรายออเดอร์ของวันนี้/วันที่เลือก (เวลาเข้า/ออก ราคา จุด และ R) แสดงอัตโนมัติเมื่อเลือกโหมดสถิติ 0 หรือ 4")
todayMaxRows = input.int(15, "จำนวนออเดอร์ล่าสุดที่แสดงในตารางรายออเดอร์ (0 = แสดงทั้งหมด)", minval=0, maxval=500, group="Stats · Tables", display=display.none,
     tooltip="0 = แสดงออเดอร์ทั้งหมดของวันที่ดู (ตารางยืดตามจำนวนออเดอร์ สูงสุดที่โค้ดจำกัดไว้ 95 แถว กันตารางใหญ่เกินจอ/เกินข้อจำกัดของ TradingView)")
showSettingsTable = input.bool(false, "Show Settings Summary Table", group="Stats · Tables", display=display.none)
mainTablePosStr     = input.string("Bottom Right",  "▶ ตำแหน่งตารางหลัก (Stats)",      options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="Stats · Tables", display=display.none)
todayTablePosStr    = input.string("Middle Right",  "▶ ตำแหน่งตารางรายออเดอร์วันนี้", options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="Stats · Tables", display=display.none)
dailyTablePosStr    = input.string("Middle Left",   "▶ ตำแหน่งตาราง Daily",            options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="Stats · Tables", display=display.none)
monthlyTablePosStr  = input.string("Bottom Center", "▶ ตำแหน่งตาราง Monthly",          options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="Stats · Tables", display=display.none)
weekdayTablePosStr  = input.string("Top Right",     "▶ ตำแหน่งตาราง Weekday",          options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="Stats · Tables", display=display.none)
settingsTablePosStr = input.string("Bottom Left",   "▶ ตำแหน่งตาราง Settings Summary", options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="Stats · Tables", display=display.none)
showOutlook = input.bool(true, "Show Pattern Outlook (คาดการณ์ pattern ของ brick ที่กำลังก่อตัว)", group="Stats · Tables", display=display.none,
     tooltip="ตารางคาดการณ์ว่าถ้า brick ที่กำลังก่อตัวปิดเป็นสีเขียว/แดง จะเกิด pattern ไหนบ้าง (ทุก Entry ไม่ขึ้นกับ Entry mode ที่เลือก) แสดงเฉพาะตอนตลาดเปิด (realtime)")
outlookTablePosStr  = input.string("Top Left", "▶ ตำแหน่งตาราง Pattern Outlook", options=["Top Left","Top Center","Top Right","Middle Left","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="Stats · Tables", display=display.none)

// ---------- ค่าที่คำนวณจากการตั้งค่าด้านบน (ไม่ใช่ช่องตั้งค่า) ----------
bool   tsxMode  = whMode == "TopstepX Clicker"
// โหมด TopstepX Clicker: บังคับ Immediate previous bar (ไม่กลับทิศใน brick เดียว) และถือได้ครั้งละ 1 ออเดอร์
string prevMode = tsxMode ? "Immediate previous bar" : prevModeIn
bool   oneOnly  = tsxMode ? true : oneOrderOnly
orderLabelSize = orderLabelSizeStr == "Tiny" ? size.tiny : orderLabelSizeStr == "Normal" ? size.normal : orderLabelSizeStr == "Large" ? size.large : orderLabelSizeStr == "Huge" ? size.huge : size.small

// ==========================================
// --- 2. UTILS ---
// ==========================================
var statsTz = "UTC" + (statsTzIncr >= 0 ? "+" : "-") + str.tostring(math.abs(statsTzIncr), "00") + ":00"

f_tablePos(string s) =>
    switch s
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        =>                 position.bottom_right

f_monthShort(int m) =>
    switch m
        1  => "Jan"
        2  => "Feb"
        3  => "Mar"
        4  => "Apr"
        5  => "May"
        6  => "Jun"
        7  => "Jul"
        8  => "Aug"
        9  => "Sep"
        10 => "Oct"
        11 => "Nov"
        =>    "Dec"

f_wrBar(float pct) =>
    string s = ""
    int filled = na(pct) ? 0 : math.min(10, math.max(0, math.round(pct / 10)))
    for _b = 1 to 10
        s += _b <= filled ? "▰" : "▱"
    s

int targetMonthNum = statTargetM == "January" ? 1 : statTargetM == "February" ? 2 : statTargetM == "March" ? 3 : statTargetM == "April" ? 4 : statTargetM == "May" ? 5 : statTargetM == "June" ? 6 : statTargetM == "July" ? 7 : statTargetM == "August" ? 8 : statTargetM == "September" ? 9 : statTargetM == "October" ? 10 : statTargetM == "November" ? 11 : 12
int actualTargetY  = statTargetY == 0 ? year(timenow, statsTz) : statTargetY
// "เดือนปัจจุบัน" อิงแท่งล่าสุดบนกราฟ
int currentTotalM  = year(time, statsTz) * 12 + month(time, statsTz)
int cutoffTime     = time - (statDays - 1) * 86400000
int cutoffDay      = year(cutoffTime, statsTz) * 10000 + month(cutoffTime, statsTz) * 100 + dayofmonth(cutoffTime, statsTz)

f_dayId(int t) =>
    year(t, statsTz) * 10000 + month(t, statsTz) * 100 + dayofmonth(t, statsTz)
int todayId = f_dayId(timenow)   // "วันนี้" อิงเวลาปัจจุบัน (timenow) ตามเขตเวลา UTC +/- ที่ตั้งไว้
bool isTodayMode = statMode == "0. วันนี้ (Today)"
bool isPickMode  = statMode == "4. เลือกวันที่จากปฏิทิน (Pick Date)"
bool isDayMode   = isTodayMode or isPickMode
int  dayModeTs   = isTodayMode ? timenow : statPickDate        // เวลาอ้างอิงของ "วันที่ที่ดู"
int  dayModeId   = f_dayId(dayModeTs)

f_inPeriod(int t) =>
    int dayId = f_dayId(t)
    if isDayMode
        dayId == dayModeId
    else if statMode == "1. ย้อนหลังตามจำนวนวัน (Days)"
        dayId >= cutoffDay
    else if statMode == "2. ย้อนหลังตามจำนวนเดือน (Months)"
        year(t, statsTz) * 12 + month(t, statsTz) >= currentTotalM - statMonths + 1
    else
        month(t, statsTz) == targetMonthNum and year(t, statsTz) == actualTargetY

// ==========================================
// --- 3. RENKO ENGULF SIGNAL ---
// ==========================================
bull = close > open
bear = close < open

var float lastBullH = na
var float lastBullL = na
var float lastBearH = na
var float lastBearL = na

// Immediate = แท่งก่อนหน้าทันทีต้องเป็นสีเดียวกัน / Last = แท่งสีเดียวกันล่าสุด (ข้ามแท่งสีตรงข้าม)
refBullH = prevMode == "Last Bull/Bear" ? lastBullH : (bull[1] ? high[1] : na)
refBullL = prevMode == "Last Bull/Bear" ? lastBullL : (bull[1] ? low[1]  : na)
refBearH = prevMode == "Last Bull/Bear" ? lastBearH : (bear[1] ? high[1] : na)
refBearL = prevMode == "Last Bull/Bear" ? lastBearL : (bear[1] ? low[1]  : na)

bool useAll    = entryMode == "All (Engulf + Reversal + NoWick)" or entryMode == "All + Pattern"
bool usePat    = entryMode == "W&M" or entryMode == "All + Pattern"
bool useRGR    = entryMode == "RGR" or entryMode == "All + Pattern"
bool useRE2    = entryMode == "RevEngulf02" or entryMode == "All + Pattern"
bool useFT     = entryMode == "FollowTrend" or entryMode == "All + Pattern"
bool useDbl    = entryMode == "Double Bottom/Top (3-2-2-3)" or entryMode == "All + Pattern"
bool useCover  = entryMode == "Reverse Engulf" or entryMode == "All + Pattern"
bool useEngulf = useAll or entryMode == "Engulf" or entryMode == "Engulf + Reversal" or entryMode == "Engulf + NoWick"
bool useRev    = useAll or entryMode == "Reversal" or entryMode == "Engulf + Reversal" or entryMode == "Reversal + NoWick"
bool useNW     = useAll or entryMode == "NoWick Reversal" or entryMode == "Engulf + NoWick" or entryMode == "Reversal + NoWick"
engulfBull = useEngulf and bull and not na(refBullH) and high >= refBullH - tol and low <= refBullL + tol
engulfBear = useEngulf and bear and not na(refBearH) and high >= refBearH - tol and low <= refBearL + tol

// Reversal entry: แท่งสีเดียวกันติดกัน >= revMin แท่ง แล้วแท่งสีตรงข้ามที่ High สูงกว่า และ Low ต่ำกว่า "แท่งล่าสุด" (= แท่งก่อนหน้าทันที)
// redRun / grnRun = จำนวนแท่งแดง/เขียวติดกัน (var อัปเดตทีละแท่ง) ส่วน redPrev / grnPrev = ค่าของ "แท่งก่อนหน้า" ก่อนอัปเดตแท่งนี้
var int redRun = 0
var int grnRun = 0
int redPrev = redRun
int grnPrev = grnRun
redRun := bear ? redRun + 1 : 0
grnRun := bull ? grnRun + 1 : 0
bool revBull = useRev and bull and redPrev >= revMin and high > high[1] and low < low[1]
bool revBear = useRev and bear and grnPrev >= revMin and high > high[1] and low < low[1]

// NoWick Reversal: แท่งสีตรงข้ามติดกัน >= nwMin แท่ง แล้วเกิดแท่งกลับสี โดยแท่งที่ติดกัน (แท่งก่อนหน้า) และแท่งที่เกิด "ไม่มีไส้" ทั้งคู่ แท่งอื่นมีไส้ได้
// no wick = High อยู่ที่ขอบบนของตัวแท่ง และ Low อยู่ที่ขอบล่างของตัวแท่ง (ยอมคลาดได้ nwTol + ครึ่ง tick)
bool noWick = high - math.max(open, close) <= nwTol + syminfo.mintick * 0.5 and math.min(open, close) - low <= nwTol + syminfo.mintick * 0.5
bool nwBull = useNW and bull and noWick and noWick[1] and redPrev >= nwMin
bool nwBear = useNW and bear and noWick and noWick[1] and grnPrev >= nwMin

// W&M: อ่านจากเก่า→ใหม่ Sell = แดง>=patMin, เขียว, แดง, เขียว, แดง(แท่งปัจจุบัน) / Buy = สีสลับกัน
// redRun[4] / grnRun[4] = จำนวนแท่งสีเดียวกันติดกันที่จบที่แท่งที่ 5 นับจากแท่งปัจจุบัน
bool patSell = usePat and bear and bull[1] and bear[2] and bull[3] and redRun[4] >= patMin
bool patBuy  = usePat and bull and bear[1] and bull[2] and bear[3] and grnRun[4] >= patMin

// Reverse Engulf: เขียว > แดง (High>=High และ Low<=Low ของเขียวแรก) > เขียว > เขียว  เข้าที่เขียวแท่งที่ 2 / Sell สลับสี
bool covBuy  = useCover and bull and bull[1] and bear[2] and bull[3] and high[2] >= high[3] - tol and low[2] <= low[3] + tol
bool covSell = useCover and bear and bear[1] and bull[2] and bear[3] and high[2] >= high[3] - tol and low[2] <= low[3] + tol

// Double Bottom/Top: Buy = แดง>=3, เขียว 2, แดง 2, เขียว 3 (เข้าที่เขียวแท่งที่ 3) / Sell สลับสี  (ช่วงกลางนับเป๊ะ)
bool dblBuy  = useDbl and bull and grnRun == 3 and redRun[3] == 2 and grnRun[5] == 2 and redRun[7] >= 3
bool dblSell = useDbl and bear and redRun == 3 and grnRun[3] == 2 and redRun[5] == 2 and grnRun[7] >= 3

// FollowTrend: Sell = แดง>=3, เขียว 2, แดง 1, เขียว 1, แดง 1(แท่งปัจจุบัน) / Buy สลับสี  (ช่วงหลังนับเป๊ะ)
bool ftSell = useFT and bear and redRun == 1 and grnRun[1] == 1 and redRun[2] == 1 and grnRun[3] == 2 and redRun[5] >= 3
bool ftBuy  = useFT and bull and grnRun == 1 and redRun[1] == 1 and grnRun[2] == 1 and redRun[3] == 2 and grnRun[5] >= 3

// RevEngulf02 (Sell = สลับสี): แดง no wick [2] > แดง [1] คลุม High-Low ของ [2] ทั้งหมด > เขียว (แท่งปัจจุบัน) ที่ Low ต่ำกว่า Low ของ [1]
bool re2Buy = useRE2 and bull and bear[1] and bear[2] and noWick[2] and high[1] >= high[2] - tol and low[1] <= low[2] + tol and low < low[1]
bool re2Sell = useRE2 and bear and bull[1] and bull[2] and noWick[2] and high[1] >= high[2] - tol and low[1] <= low[2] + tol and high > high[1]

// RGR (เข้าตามสีของแท่งล่าสุด): Sell = แดง > เขียว > แดง (แท่งปัจจุบันเป็นแดง) / Buy = เขียว > แดง > เขียว (แท่งปัจจุบันเป็นเขียว)
bool rgrSell = useRGR and bear and bull[1] and bear[2]
bool rgrBuy  = useRGR and bull and bear[1] and bull[2]

// ---- ประวัติ brick ที่ "ปิดแล้ว" (index 0 = brick ล่าสุดที่ปิด) ใช้กับตาราง Pattern Outlook โดยไม่ปนกับค่า tick ของแท่งที่กำลังก่อตัว ----
var array<bool>  cBull  = array.new_bool()
var array<float> cHigh  = array.new_float()
var array<float> cLow   = array.new_float()
var array<float> cOpen  = array.new_float()
var array<float> cClose = array.new_float()
var array<int>   cRed   = array.new_int()
var array<int>   cGrn   = array.new_int()
var array<bool>  cNW    = array.new_bool()
if barstate.isconfirmed
    array.unshift(cBull, bull)
    array.unshift(cHigh, high)
    array.unshift(cLow, low)
    array.unshift(cOpen, open)
    array.unshift(cClose, close)
    array.unshift(cRed, redRun)
    array.unshift(cGrn, grnRun)
    array.unshift(cNW, noWick)
    if array.size(cBull) > 12
        array.pop(cBull), array.pop(cHigh), array.pop(cLow), array.pop(cOpen)
        array.pop(cClose), array.pop(cRed), array.pop(cGrn), array.pop(cNW)

if bull
    lastBullH := high
    lastBullL := low
if bear
    lastBearH := high
    lastBearL := low

// ==========================================
// --- 4. TRADE ENGINE ---
// ==========================================
var array<bool>  resIsWin = array.new_bool()
var array<float> resR     = array.new_float()   // ผลลัพธ์เป็น R (1R = 2 box จากราคาเข้า)
var array<float> resPts   = array.new_float()   // ผลลัพธ์เป็นราคา (points) มีเครื่องหมาย
var array<int>   resTime  = array.new_int()     // เวลาที่เปิดออเดอร์
var array<bool>  resIsBuy = array.new_bool()
var array<float> resEntryPx = array.new_float()   // ราคาเข้า
var array<float> resExitPx  = array.new_float()   // ราคาออก
var array<int>   resExitTime = array.new_int()    // เวลาออก

var int chartFirstT = time   // เวลาของแท่งแรกที่ชาร์ตโหลดมา (ใช้แสดงในแถว History ของตารางสถิติ)
var int   pos         = 0            // ทิศของออเดอร์ที่เปิดอยู่ (1 = Buy, -1 = Sell, 0 = ไม่มี)
var float entryPrice  = na           // ราคาเข้าล่าสุด (ใช้แสดงในตาราง)
var array<float> oPx   = array.new_float()   // ออเดอร์ที่เปิดอยู่ (หลายออเดอร์ได้เมื่อปิด One order at a time)
var array<float> oRisk = array.new_float()
var array<int>   oBar  = array.new_int()
var array<int>   oTime = array.new_int()

var int sameCnt = 0                  // จำนวน box สีเดียวกับทิศออเดอร์ที่นับได้ตั้งแต่เข้า (ใช้กับ Exit mode = N same-color boxes)

float exitPx = close
float riskNow  = math.max(2.0 * math.abs(close - open), syminfo.mintick)   // 1R = 2 box (box = ตัว brick |close-open|) ใช้ตอนเข้าออเดอร์
bool engineOn  = barstate.isconfirmed   // Renko: brick ที่กำลังก่อตัว (live) ยังไม่ confirmed และเปลี่ยนทุก tick → ตัดสินเฉพาะ brick ที่เกิดจริงแล้ว
// ---- Exit mode: เลือกอย่างเดียว (Opposite brick / N same-color boxes / TP / SL ตามระยะราคา) ----
bool isOpp     = exitMode == "Opposite brick"
bool isNSame   = exitMode == "N same-color boxes"
bool isSLTP    = exitMode == "TP / SL (price distance)"
// โหมด TP / SL: ระดับ = ราคาเข้า ± ระยะ (หน่วยราคา) ตรวจจาก High/Low ของ brick ที่ confirmed (รวมไส้) ถ้าใน brick เดียวแตะทั้งสองถือว่า SL ก่อน
float entryE   = array.size(oPx) > 0 ? array.get(oPx, 0) : na   // ราคาเข้าของออเดอร์แรกที่เปิดอยู่
float epsTk    = syminfo.mintick * 0.5
bool tpHit     = false
bool slHit     = false
float slTpPx   = na
if engineOn and isSLTP and pos != 0 and not na(entryE)
    if pos == 1
        tpHit := tpPts > 0 and high >= entryE + tpPts - epsTk
        slHit := slPts > 0 and low <= entryE - slPts + epsTk
    else
        tpHit := tpPts > 0 and low <= entryE - tpPts + epsTk
        slHit := slPts > 0 and high >= entryE + slPts - epsTk
    if slHit
        tpHit := false
        slTpPx := pos == 1 ? entryE - slPts : entryE + slPts
    else if tpHit
        slTpPx := pos == 1 ? entryE + tpPts : entryE - tpPts
bool slTpExit  = tpHit or slHit
if slTpExit and not na(slTpPx)
    exitPx := slTpPx   // ผลสถิติคิดที่ราคาระดับ SL/TP พอดี (ใกล้เคียงโบรกเกอร์มากกว่าราคาปิด brick)
bool oppOK     = isOpp   // ออกเมื่อเจอ box สีตรงข้าม เฉพาะโหมด Opposite brick
bool sameColor = (pos == 1 and bull) or (pos == -1 and bear)
bool nHit      = false
if engineOn and pos != 0 and sameColor   // pos != 0 ตรงนี้ = แท่งหลังแท่งที่เข้า (การเข้าถูกประมวลผลต่ำกว่านี้ในแท่งเดียวกัน)
    sameCnt += 1
    nHit := isNSame and sameCnt >= exitN
bool exitLong  = engineOn and pos ==  1 and ((bear and oppOK) or nHit or slTpExit)
bool exitShort = engineOn and pos == -1 and ((bull and oppOK) or nHit or slTpExit)
bool exitedNow = exitLong or exitShort

if exitLong or exitShort
    color closeCol = na
    for i = 0 to array.size(oPx) - 1
        float ePx = array.get(oPx, i)
        float pnl = pos == 1 ? exitPx - ePx : ePx - exitPx
        float rr  = pnl / array.get(oRisk, i)
        bool  win = pnl > 0
        array.push(resIsWin, win)
        array.push(resR, rr)
        array.push(resPts, pnl)
        array.push(resTime, array.get(oTime, i))
        array.push(resIsBuy, pos == 1)
        array.push(resEntryPx, ePx)
        array.push(resExitPx, exitPx)
        array.push(resExitTime, time)
        if array.size(resIsWin) > 5000
            array.shift(resIsWin), array.shift(resR), array.shift(resPts), array.shift(resTime), array.shift(resIsBuy)
            array.shift(resEntryPx), array.shift(resExitPx), array.shift(resExitTime)
        closeCol := win ? color.green : color.red
        label.new(bar_index, exitPx, "", style=label.style_circle, color=color.new(closeCol, 50), size=size.normal)
        label.new(bar_index, exitPx, "Close " + (pos == 1 ? "Buy" : "Sell") + (tpHit ? " TP" : slHit ? " SL" : "") + "\n" + (rr >= 0 ? "+" : "") + str.tostring(rr, "#.##") + "R",
             style = pos == 1 ? label.style_label_down : label.style_label_up, color=color.new(color.gray, 20), textcolor=color.white, size=size.small)
        line.new(bar_index - 1, exitPx, bar_index + 1, exitPx, color=closeCol, width=2)
        if showTradePath
            line.new(array.get(oTime, i), ePx, time, exitPx, xloc=xloc.bar_time, color=color.new(closeCol, 60), width=1, style=line.style_dashed)  // ใช้เวลาแทน bar_index: เทรดที่ถือนานเกิน 500 แท่งจะเกินระยะที่ line.new รับได้
    array.clear(oPx), array.clear(oRisk), array.clear(oBar), array.clear(oTime)
    pos := 0
    entryPrice := na
    sameCnt := 0

// เข้าออเดอร์ (ถ้าเพิ่งออกในแท่งนี้ = กลับทิศได้ทันที)
// One order at a time = เปิดอยู่ 1 ออเดอร์ สัญญาณใหม่ถูกข้ามจนกว่าจะปิด / ปิด = ซ้อนออเดอร์ทิศเดียวกันได้
// โหมด TopstepX Clicker: ไม่เปิดใหม่ใน brick เดียวกับที่เพิ่งออก (กันบอทกดซื้อ-ขายพร้อมกันและลำดับสัญญาณสลับ)
// ---- ตัวกรองช่วงเวลางดเทรด (UTC+7): งดเปิดออเดอร์ใหม่เท่านั้น ส่วนการออกยังทำงานปกติ ----
// เวลาที่ใช้ตัดสิน: realtime = เวลาปัจจุบัน (ตอน brick ปิด) / ย้อนหลัง = เวลาของแท่ง (ประมาณ)
f_sessMin(string sess, bool isStart) =>
    string t = isStart ? str.substring(sess, 0, 4) : str.substring(sess, 5, 9)
    int(str.tonumber(str.substring(t, 0, 2)) * 60 + str.tonumber(str.substring(t, 2, 4)))

f_inWin(string sess, int m) =>
    int a = f_sessMin(sess, true)
    int b = f_sessMin(sess, false)
    a == b ? false : a < b ? (m >= a and m < b) : (m >= a or m < b)

int  sigTs      = barstate.isrealtime ? timenow : time
int  minNow     = hour(sigTs, "UTC+7") * 60 + minute(sigTs, "UTC+7")
bool inBlackout = tfEnable and (f_inWin(tfSess1, minNow) or f_inWin(tfSess2, minNow) or f_inWin(tfSess3, minNow))
bgcolor(showTfBg and inBlackout ? color.new(color.gray, 85) : na, title="No-trade window")

bool candBuy  = engineOn and allowLong and not inBlackout and (engulfBull or revBull or nwBull or patBuy or covBuy or dblBuy or ftBuy or re2Buy or rgrBuy)
bool candSell = engineOn and allowShort and not inBlackout and (engulfBear or revBear or nwBear or patSell or covSell or dblSell or ftSell or re2Sell or rgrSell)
// โหมด TopstepX Clicker: ห้ามเข้า "ทิศเดิม" ใน brick เดียวกับที่เพิ่งออก เพราะบอทจะได้คำสั่งสวนกัน (sell แล้ว buy) ลำดับอาจสลับ
// แต่การออกแล้วกลับทิศ (ออก long = sell + เข้า short = sell / ออก short = buy + เข้า long = buy) คำสั่งเหมือนกัน ทำได้
bool reEntry = (exitLong and candBuy) or (exitShort and candSell)
bool canOpen = (not oneOnly or array.size(oPx) == 0) and not (tsxMode and reEntry)
bool buySig  = candBuy  and canOpen
bool sellSig = candSell and canOpen

if buySig or sellSig
    pos := buySig ? 1 : -1
    sameCnt := countEntry ? 1 : 0
    entryPrice := close
    array.push(oPx, close)
    array.push(oRisk, riskNow)
    array.push(oBar, bar_index)
    array.push(oTime, time)
    color sideCol = buySig ? color.green : color.red
    label.new(bar_index, close, "", style=label.style_circle, color=color.new(sideCol, 70), size=size.large)
    label.new(bar_index, buySig ? low : high, buySig ? (engulfBull ? "Buy\nEngulf" : revBull ? "Buy\nRev" : patBuy ? "Buy\nW&M" : covBuy ? "Buy\nReverse Engulf" : dblBuy ? "Buy\nDouble" : ftBuy ? "Buy\nFollowTrend" : re2Buy ? "Buy\nRevEngulf02" : rgrBuy ? "Buy\nRGR" : "Buy\nNoWick") : (engulfBear ? "Sell\nEngulf" : revBear ? "Sell\nRev" : patSell ? "Sell\nW&M" : covSell ? "Sell\nReverse Engulf" : dblSell ? "Sell\nDouble" : ftSell ? "Sell\nFollowTrend" : re2Sell ? "Sell\nRevEngulf02" : rgrSell ? "Sell\nRGR" : "Sell\nNoWick"),
         style = buySig ? label.style_label_up : label.style_label_down, color=color.new(sideCol, 25), textcolor=color.white, size=orderLabelSize)
    if showEntryLine
        line.new(bar_index, close, bar_index + 6, close, color=color.new(sideCol, 30), width=2)
        label.new(bar_index + 6, close, str.tostring(close, format.mintick), style=label.style_label_left, color=color.new(sideCol, 80), textcolor=sideCol, size=size.small)

// ==========================================
// --- ALERT: ส่ง 1 ข้อความต่อ brick ที่มีเหตุการณ์ (ปิดก่อน แล้วเปิด) ---
// ==========================================
string whClose = exitLong ? "buy" : exitShort ? "sell" : ""
string whOpen  = buySig ? "buy" : sellSig ? "sell" : ""
// เรียก alert() ตอน brick confirmed พอดี (ครั้งเดียวต่อแท่ง) → ใช้ freq_all เพราะ once_per_bar ส่งเฉพาะการเรียกแรกของแท่ง ทำให้ ENTER หลัง EXIT หายได้ และ once_per_bar_close บน Renko จะรอจนเปิด brick ถัดไป
// ---- OKX: สร้างข้อความ (ใช้ timenow ตอนส่งจริง) / ENTER ที่พักไว้ตอนกลับทิศ ----
varip string okxPendEnter = ""
varip int    okxPendT     = 0
f_okxMsg(string act) =>
    string ts   = str.format_time(timenow, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")
    string head = '{"action":"' + act + '","instrument":"' + whInstId + '","signalToken":"' + whSignalToken + '","timestamp":"' + ts + '","maxLag":"' + str.tostring(okxMaxLag) + '","orderType":"market"'
    // ขนาดออเดอร์ (เฉพาะขาเข้า): Bot setting = ไม่ส่ง / อื่นๆ = ส่ง investmentType + amount คู่กัน (OKX กำหนดให้ส่งคู่หรือไม่ส่งเลย)
    string size = str.startswith(act, "EXIT") ? ',"investmentType":"percentage_position","amount":"100"' : okxSizeMode == "Bot setting" ? "" : ',"investmentType":"' + okxSizeMode + '","amount":"' + str.tostring(okxAmount, "#.####") + '"'
    head + size + '}'

// ส่ง ENTER ที่พักไว้เมื่อครบเวลาหน่วง (รันทุก tick ของ brick ถัดไป) ถ้าเปลี่ยนโหมด/ไม่มี token จะทิ้ง
if okxPendEnter != ""
    if whMode != "OKX Signal Bot" or str.length(whSignalToken) == 0
        okxPendEnter := ""
    else if barstate.isrealtime and timenow - okxPendT >= okxGapMs
        alert(f_okxMsg(okxPendEnter), alert.freq_all)
        okxPendEnter := ""

if whClose != "" or whOpen != ""
    if whMode == "Text only (pop-up)"
        string txt = syminfo.ticker + " [Renko] " + (whClose != "" ? "EXIT " + (whClose == "buy" ? "BUY" : "SELL") : "") +
             (whClose != "" and whOpen != "" ? " → " : "") + (whOpen != "" ? (whOpen == "buy" ? "BUY" : "SELL") + " ENTRY" : "") +
             " @ " + str.tostring(close, format.mintick) + "  (brick " + str.tostring(open, format.mintick) + "→" + str.tostring(close, format.mintick) + ")"
        alert(txt, alert.freq_all)
    else if whMode == "OKX Signal Bot"
        // รูปแบบเดียวกับไฟล์ reference (FeeInvest ATV1.0 WebhookOKX): ค่าตัวเลขส่งเป็นสตริง, EXIT ปิด 100% ของ position ในบอท
        // ไม่มี signalToken = ไม่ส่ง (กันส่งข้อความเปล่าไป OKX)
        // กลับทิศ (ออก+เข้าใน brick เดียว): ส่ง EXIT ทันที แล้วพัก ENTER ไว้ส่งหลังครบ okxGapMs (ดูด้านล่าง) เพื่อให้ลำดับ EXIT → ENTER ถึง OKX ถูกต้อง
        if str.length(whSignalToken) == 0
            if barstate.isrealtime
                label.new(bar_index, close, "OKX ไม่ส่ง: ยังไม่ได้ใส่ signalToken", style=label.style_label_down, color=color.new(color.orange, 20), textcolor=color.white, size=size.small)
        else
            if whClose != ""
                alert(f_okxMsg(whClose == "buy" ? "EXIT_LONG" : "EXIT_SHORT"), alert.freq_all)
            if whOpen != ""
                string okxEnterAct = whOpen == "buy" ? "ENTER_LONG" : "ENTER_SHORT"
                if whClose != "" and okxGapMs > 0 and barstate.isrealtime
                    okxPendEnter := okxEnterAct
                    okxPendT := timenow
                else
                    alert(f_okxMsg(okxEnterAct), alert.freq_all)
    else if tsxMode
        // ส่ง "คำสั่งที่ต้องกดจริง" (ไม่มีการส่ง buy/sell ตรงข้ามเพื่อออกเลย จึงไม่เสี่ยงเปิดสถานะกลับทิศ)
        //  - ออก: action "close" (บอทกด Close Position + Cancel All ซ้ำได้ ปลอดภัยแม้ SL/TP ใน TopstepX ปิดสถานะไปก่อนแล้ว)
        //  - เข้า: action "buy" / "sell"
        //  - ออก+เข้าใน brick เดียวกัน (กลับทิศ): ข้อความเดียว close_first=true บอทปิดก่อนแล้วค่อยเข้า (ลำดับไม่สลับ)
        string tsxHead = '{"secret":"' + whSecret + '","t":' + str.tostring(timenow)
        string tsxId   = str.tostring(time) + '-' + str.tostring(bar_index)
        if whClose != "" and whOpen != ""
            alert(tsxHead + ',"action":"' + whOpen + '","event":"entry","close_first":true,"id":"' + tsxId + '-r"}', alert.freq_all)
        else if whClose != ""
            alert(tsxHead + ',"action":"close","event":"exit","id":"' + tsxId + '-x"}', alert.freq_all)
        else if whOpen != ""
            alert(tsxHead + ',"action":"' + whOpen + '","event":"entry","id":"' + tsxId + '-e"}', alert.freq_all)

// ---- ส่งสัญญาณทดสอบ 1 ครั้ง (varip = จำค่าข้าม tick ใน realtime กันยิงซ้ำ; รีเซ็ตเมื่อสคริปต์โหลดใหม่/Alert เริ่มใหม่) ----
varip bool testSent = false
if tsxMode and testSend and barstate.isrealtime and not testSent
    testSent := true
    alert('{"secret":"' + whSecret + '","t":' + str.tostring(timenow) + ',"action":"' + testAct + '","event":"entry","id":"test-' + str.tostring(timenow) + '"}', alert.freq_once_per_bar)
    label.new(bar_index, high, "TEST " + testAct, style=label.style_label_down, color=color.new(color.orange, 20), textcolor=color.white, size=size.small)

// alertcondition: เลือกส่งทีละสัญญาณได้ (ไม่ต้องใช้ "Any alert() function call") เช่น Buy อย่างเดียว / Sell อย่างเดียว / ไม่ใช้ Exit เลย
// ข้อความเป็น JSON สำหรับบอท TopstepX โดย **ไม่มี secret** (alertcondition ฝังค่า input ไม่ได้) ให้ใส่ secret ที่ท้าย Webhook URL แทน: https://โดเมนของคุณ/?secret=รหัสของคุณ
// ตั้ง Frequency เป็น Once Per Bar (ไม่ใช่ Once Per Bar Close บน Renko)  Exit = ส่ง "close" (กด Close Position)
alertcondition(buySig,    "Renko Buy",       '{"action":"buy","event":"entry","id":"b-{{timenow}}","ts":"{{timenow}}"}')
alertcondition(sellSig,   "Renko Sell",      '{"action":"sell","event":"entry","id":"s-{{timenow}}","ts":"{{timenow}}"}')
alertcondition(exitLong,  "Renko Exit Buy",  '{"action":"close","event":"exit","id":"xl-{{timenow}}","ts":"{{timenow}}"}')
alertcondition(exitShort, "Renko Exit Sell", '{"action":"close","event":"exit","id":"xs-{{timenow}}","ts":"{{timenow}}"}')

// ==========================================
// --- 5. LUXE TABLE THEME ---
// ==========================================
color lxGold    = color.rgb(212, 175, 55)
color lxTitleTx = color.rgb(236, 210, 140)
color lxHeadBg  = color.new(color.rgb(26, 32, 52), 6)
color lxSubBg   = color.new(color.rgb(19, 24, 40), 8)
color lxColHd   = color.rgb(150, 160, 182)
color lxRowA    = color.new(color.rgb(13, 17, 28), 14)
color lxRowB    = color.new(color.rgb(22, 28, 46), 14)
color lxRowDim  = color.new(color.rgb(13, 17, 28), 52)
color lxText    = color.rgb(233, 236, 243)
color lxMuted   = color.rgb(128, 138, 158)
color lxDimTx   = color.rgb(90, 98, 116)
color lxGreen   = color.rgb(64, 216, 158)
color lxRed     = color.rgb(250, 118, 118)
color lxAmber   = color.rgb(251, 191, 36)
color lxCyan    = color.rgb(102, 208, 255)
color lxFrame   = color.new(lxGold, 42)
color lxGrid    = color.new(color.rgb(7, 10, 17), 35)
color lxBestBg  = color.new(lxGold, 84)

var table statsTable        = table.new(f_tablePos(mainTablePosStr),     4, 10,             bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)
var table dailyStatsTable   = table.new(f_tablePos(dailyTablePosStr),    6, 34,             bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)
var table monthlyStatsTable = table.new(f_tablePos(monthlyTablePosStr),  5, statMonths + 3, bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)
var table settingsTable     = table.new(f_tablePos(settingsTablePosStr), 2, 8,              bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)
var table todayTbl = na   // สร้างใหม่ทุกครั้งที่วาด เพราะจำนวนแถวเปลี่ยนตามจำนวนออเดอร์ของวันที่ดู
var table weekdayStatsTable = table.new(f_tablePos(weekdayTablePosStr),  6, 10,             bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)

var table outlookTbl        = table.new(f_tablePos(outlookTablePosStr),  4, 16, bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)

var bool[] lxMergedArr = array.new_bool(8, false)

f_rStr(float r) =>
    (r >= 0 ? "+" : "") + str.tostring(r, "#.##") + "R"

f_posColor(float v, bool empty) =>
    empty ? lxDimTx : v > 0 ? lxGreen : v < 0 ? lxRed : lxAmber

f_drawStats() =>
    int   winCnt = 0
    int   lossCnt = 0
    int   buyW = 0
    int   buyL = 0
    int   sellW = 0
    int   sellL = 0
    int   streak = 0
    int   maxW = 0
    int   maxL = 0
    int   curStreakStart = 0
    int   maxWStart = 0
    int   maxWEnd = 0
    int   maxLStart = 0
    int   maxLEnd = 0
    float netR = 0.0
    float netPts = 0.0
    float grossWin = 0.0
    float grossLoss = 0.0
    float curWinSum = 0.0
    float curLossSum = 0.0
    float maxWinR = 0.0
    float maxLossR = 0.0
    float curWinPts = 0.0
    float curLossPts = 0.0
    float maxWinPts = 0.0
    float maxLossPts = 0.0
    float eq = 0.0
    float peak = 0.0
    float maxDD = 0.0
    if array.size(resIsWin) > 0
        for i = 0 to array.size(resIsWin) - 1
            int t = array.get(resTime, i)
            if f_inPeriod(t)
                float tradeR = array.get(resR, i)
                float tPts   = array.get(resPts, i)
                bool  isWin  = array.get(resIsWin, i)
                bool  isBuy  = array.get(resIsBuy, i)
                netR += tradeR
                netPts += tPts
                eq += tradeR
                peak := math.max(peak, eq)
                maxDD := math.max(maxDD, peak - eq)
                if streak == 0
                    curStreakStart := t
                if isWin
                    winCnt += 1
                    grossWin += tradeR
                    if isBuy
                        buyW += 1
                    else
                        sellW += 1
                    curWinSum := streak >= 0 ? curWinSum + tradeR : tradeR
                    curWinPts := streak >= 0 ? curWinPts + tPts : tPts
                    if streak < 0
                        curStreakStart := t
                    streak := streak >= 0 ? streak + 1 : 1
                    if streak > maxW
                        maxW := streak
                        maxWStart := curStreakStart
                        maxWEnd := t
                    maxWinR := math.max(maxWinR, curWinSum)
                    maxWinPts := math.max(maxWinPts, curWinPts)
                else
                    lossCnt += 1
                    grossLoss += -tradeR
                    if isBuy
                        buyL += 1
                    else
                        sellL += 1
                    curLossSum := streak <= 0 ? curLossSum + tradeR : tradeR
                    curLossPts := streak <= 0 ? curLossPts + tPts : tPts
                    if streak > 0
                        curStreakStart := t
                    streak := streak <= 0 ? streak - 1 : -1
                    if -streak > maxL
                        maxL := -streak
                        maxLStart := curStreakStart
                        maxLEnd := t
                    maxLossR := math.min(maxLossR, curLossSum)
                    maxLossPts := math.min(maxLossPts, curLossPts)
    int    totalCnt = winCnt + lossCnt
    float  wr = totalCnt > 0 ? (winCnt * 1.0 / totalCnt) * 100 : na
    color  wrColor = na(wr) ? lxMuted : wr >= 50 ? lxGreen : lxAmber
    color  netRColor = f_posColor(netR, totalCnt == 0)
    string netRStr = totalCnt == 0 ? "-" : f_rStr(netR)
    string streakStr = streak > 0 ? "W" + str.tostring(streak) : streak < 0 ? "L" + str.tostring(-streak) : "-"
    color  streakColor = streak > 0 ? lxGreen : streak < 0 ? lxRed : lxMuted
    string pfStr = totalCnt == 0 ? "-" : grossLoss > 0 ? str.tostring(grossWin / grossLoss, "#.##") : "∞"
    string periodStr = ""
    if isDayMode
        periodStr := (isTodayMode ? "Today " : "Date ") + str.format_time(dayModeTs, "dd MMM yyyy", statsTz)
    else if statMode == "1. ย้อนหลังตามจำนวนวัน (Days)"
        periodStr := "Last " + str.tostring(statDays) + " Days"
    else if statMode == "2. ย้อนหลังตามจำนวนเดือน (Months)"
        periodStr := "Last " + str.tostring(statMonths) + " Months"
    else
        periodStr := statTargetM + " " + str.tostring(actualTargetY)
    string maxWDateStr = maxW > 0 ? str.tostring(dayofmonth(maxWStart, statsTz)) + " " + f_monthShort(month(maxWStart, statsTz)) + " – " + str.tostring(dayofmonth(maxWEnd, statsTz)) + " " + f_monthShort(month(maxWEnd, statsTz)) : "-"
    string maxLDateStr = maxL > 0 ? str.tostring(dayofmonth(maxLStart, statsTz)) + " " + f_monthShort(month(maxLStart, statsTz)) + " – " + str.tostring(dayofmonth(maxLEnd, statsTz)) + " " + f_monthShort(month(maxLEnd, statsTz)) : "-"
    string posStr = pos == 1 ? "BUY @ " + str.tostring(entryPrice, format.mintick) : pos == -1 ? "SELL @ " + str.tostring(entryPrice, format.mintick) : "Flat"

    // ---- ตารางหลัก: การ์ดตัวเลข 4 ช่อง + รายละเอียดแบบย่อ ----
    string modeLbl = str.startswith(entryMode, "All") ? "All patterns" : entryMode
    color  posCol  = pos == 1 ? lxGreen : pos == -1 ? lxRed : lxMuted
    string posTag  = pos == 1 ? "BUY" : pos == -1 ? "SELL" : "FLAT"
    string maxWR   = maxW > 0 ? "W" + str.tostring(maxW) + " · " + (totalCnt == 0 ? "-" : "+" + str.tostring(maxWinR, "#.##") + "R") + "   " + maxWDateStr : "-"
    string maxLR   = maxL > 0 ? "L" + str.tostring(maxL) + " · " + (totalCnt == 0 ? "-" : str.tostring(maxLossR, "#.##") + "R") + "   " + maxLDateStr : "-"
    table.cell(statsTable, 0, 0, "◆  RENKO  ·  " + modeLbl, text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    table.cell(statsTable, 0, 1, periodStr + "  ·  1R = 2 boxes", text_color=lxMuted, text_size=size.tiny, bgcolor=lxSubBg, text_halign=text.align_left)
    table.cell(statsTable, 3, 1, posTag, text_color=posCol, text_size=size.tiny, bgcolor=lxSubBg, text_halign=text.align_center)
    table.cell(statsTable, 0, 2, "NET R",      text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_center)
    table.cell(statsTable, 1, 2, "WINRATE",    text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_center)
    table.cell(statsTable, 2, 2, "PROFIT F.",  text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_center)
    table.cell(statsTable, 3, 2, "MAX DD",     text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_center)
    table.cell(statsTable, 0, 3, totalCnt == 0 ? "-" : (netR >= 0 ? "+" : "") + str.tostring(netR, "#.#"), text_color=netRColor, text_size=size.large, bgcolor=lxRowA, text_halign=text.align_center)
    table.cell(statsTable, 1, 3, na(wr) ? "-" : str.tostring(wr, "#.#") + "%", text_color=wrColor, text_size=size.large, bgcolor=lxRowA, text_halign=text.align_center)
    table.cell(statsTable, 2, 3, pfStr, text_color=lxAmber, text_size=size.large, bgcolor=lxRowA, text_halign=text.align_center)
    table.cell(statsTable, 3, 3, totalCnt == 0 ? "-" : "-" + str.tostring(maxDD, "#.#") + "R", text_color=maxDD > 0 ? lxRed : lxMuted, text_size=size.large, bgcolor=lxRowA, text_halign=text.align_center)
    table.cell(statsTable, 0, 4, totalCnt == 0 ? "" : (netPts >= 0 ? "+" : "") + str.tostring(netPts, "#.##") + " pts", text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_center)
    table.cell(statsTable, 1, 4, na(wr) ? "" : f_wrBar(wr), text_color=wrColor, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_center)
    table.cell(statsTable, 2, 4, str.tostring(totalCnt) + " trades", text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_center)
    table.cell(statsTable, 3, 4, "streak " + streakStr, text_color=streakColor, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_center)
    table.cell(statsTable, 0, 5, "DETAIL", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(statsTable, 0, 6, "W / L", text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowB, text_halign=text.align_left)
    table.cell(statsTable, 1, 6, totalCnt == 0 ? "-" : str.tostring(winCnt) + "W · " + str.tostring(lossCnt) + "L   (Buy " + str.tostring(buyW) + "-" + str.tostring(buyL) + " · Sell " + str.tostring(sellW) + "-" + str.tostring(sellL) + ")", text_color=lxText, text_size=size.small, bgcolor=lxRowB, text_halign=text.align_right)
    table.cell(statsTable, 0, 7, "Best streak", text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_left)
    table.cell(statsTable, 1, 7, maxWR, text_color=maxW > 0 ? lxGreen : lxMuted, text_size=size.small, bgcolor=lxRowA, text_halign=text.align_right)
    table.cell(statsTable, 0, 8, "Worst streak", text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowB, text_halign=text.align_left)
    table.cell(statsTable, 1, 8, maxLR, text_color=maxL > 0 ? lxRed : lxMuted, text_size=size.small, bgcolor=lxRowB, text_halign=text.align_right)
    // แถวตรวจสอบประวัติ: วันที่แท่งแรกที่ชาร์ตโหลดมา / วันที่เทรดแรกสุดที่ indicator นับได้ / จำนวนเทรดที่เก็บทั้งหมด (ก่อนกรองช่วงสถิติ)
    int    histN  = array.size(resTime)
    string firstBarStr = str.format_time(chartFirstT, "dd MMM yy", statsTz)
    string firstTrdStr = histN > 0 ? str.format_time(array.get(resTime, 0), "dd MMM yy", statsTz) : "-"

    table.cell(statsTable, 0, 9, "History", text_color=lxDimTx, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_left)
    table.cell(statsTable, 1, 9, "Chart " + firstBarStr + " · 1st " + firstTrdStr + " · " + str.tostring(histN) + "T", text_color=lxMuted, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_right)
    if not array.get(lxMergedArr, 1)
        array.set(lxMergedArr, 1, true)
        table.merge_cells(statsTable, 0, 0, 3, 0)
        table.merge_cells(statsTable, 0, 1, 2, 1)
        table.merge_cells(statsTable, 0, 5, 3, 5)
        for rr = 6 to 9
            table.merge_cells(statsTable, 1, rr, 3, rr)

f_drawDaily() =>
    int[]    ddWin  = array.new_int(32, 0)
    int[]    ddLoss = array.new_int(32, 0)
    float[]  ddNetR = array.new_float(32, 0.0)
    float[]  ddPts  = array.new_float(32, 0.0)
    string[] ddStr  = array.new_string(32, "")
    if array.size(resIsWin) > 0
        for k = 0 to array.size(resIsWin) - 1
            int t = array.get(resTime, k)
            if month(t, statsTz) == targetMonthNum and year(t, statsTz) == actualTargetY
                int d = dayofmonth(t, statsTz)
                bool isWin = array.get(resIsWin, k)
                float tradeR = array.get(resR, k)
                if isWin
                    array.set(ddWin, d, array.get(ddWin, d) + 1)
                else
                    array.set(ddLoss, d, array.get(ddLoss, d) + 1)
                array.set(ddNetR, d, array.get(ddNetR, d) + tradeR)
                array.set(ddPts, d, array.get(ddPts, d) + array.get(resPts, k))
                array.set(ddStr, d, array.get(ddStr, d) + (array.get(resIsBuy, k) ? "Buy " : "Sell ") + f_rStr(tradeR) + "\n")
    table.cell(dailyStatsTable, 0, 0, "◆  DAILY LOG  ·  " + statTargetM + " " + str.tostring(actualTargetY), text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    table.cell(dailyStatsTable, 0, 1, "DATE",   text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(dailyStatsTable, 1, 1, "W-L",    text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(dailyStatsTable, 2, 1, "WR%",    text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(dailyStatsTable, 3, 1, "NET R",  text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(dailyStatsTable, 4, 1, "POINTS", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(dailyStatsTable, 5, 1, "TRADES", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    int totW = 0
    int totL = 0
    float totR = 0.0
    float totP = 0.0
    for d = 1 to 31
        int dw = array.get(ddWin, d)
        int dl = array.get(ddLoss, d)
        float dnr = array.get(ddNetR, d)
        float dp = array.get(ddPts, d)
        int dtot = dw + dl
        float dwr = dtot > 0 ? (dw * 1.0 / dtot) * 100.0 : na
        color dwrC = na(dwr) ? lxDimTx : dwr >= 50.0 ? lxGreen : lxAmber
        string tradeS = array.get(ddStr, d)
        if str.length(tradeS) > 0
            tradeS := str.substring(tradeS, 0, str.length(tradeS) - 1)
        color dayBg = dtot == 0 ? lxRowDim : d % 2 == 1 ? lxRowA : lxRowB
        color dateC = dtot == 0 ? lxDimTx : lxText
        table.cell(dailyStatsTable, 0, d + 1, str.tostring(d), text_color=dateC, text_size=size.tiny, bgcolor=dayBg)
        table.cell(dailyStatsTable, 1, d + 1, dtot == 0 ? "-" : str.tostring(dw) + "W · " + str.tostring(dl) + "L", text_color=dateC, text_size=size.tiny, bgcolor=dayBg)
        table.cell(dailyStatsTable, 2, d + 1, na(dwr) ? "-" : str.tostring(dwr, "#.#") + "%", text_color=dwrC, text_size=size.tiny, bgcolor=dayBg)
        table.cell(dailyStatsTable, 3, d + 1, dtot == 0 ? "-" : f_rStr(dnr), text_color=f_posColor(dnr, dtot == 0), text_size=size.tiny, bgcolor=dayBg, text_halign=text.align_right)
        table.cell(dailyStatsTable, 4, d + 1, dtot == 0 ? "-" : (dp >= 0 ? "+" : "") + str.tostring(dp, "#.##"), text_color=f_posColor(dp, dtot == 0), text_size=size.tiny, bgcolor=dayBg, text_halign=text.align_right)
        table.cell(dailyStatsTable, 5, d + 1, tradeS, text_color=color.new(lxText, 22), text_size=size.tiny, bgcolor=dayBg, text_halign=text.align_left)
        totW += dw
        totL += dl
        totR += dnr
        totP += dp
    int totTot = totW + totL
    float totWR = totTot > 0 ? (totW * 1.0 / totTot) * 100.0 : na
    color totWRC = na(totWR) ? lxDimTx : totWR >= 50 ? lxGreen : lxAmber
    table.cell(dailyStatsTable, 0, 33, "TOTAL", text_color=lxTitleTx, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_left)
    table.cell(dailyStatsTable, 1, 33, totTot == 0 ? "-" : str.tostring(totW) + "W · " + str.tostring(totL) + "L", text_color=lxText, text_size=size.tiny, bgcolor=lxHeadBg)
    table.cell(dailyStatsTable, 2, 33, na(totWR) ? "-" : str.tostring(totWR, "#.#") + "%", text_color=totWRC, text_size=size.tiny, bgcolor=lxHeadBg)
    table.cell(dailyStatsTable, 3, 33, totTot == 0 ? "-" : f_rStr(totR), text_color=f_posColor(totR, totTot == 0), text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_right)
    table.cell(dailyStatsTable, 4, 33, totTot == 0 ? "-" : (totP >= 0 ? "+" : "") + str.tostring(totP, "#.##"), text_color=f_posColor(totP, totTot == 0), text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_right)
    table.cell(dailyStatsTable, 5, 33, na(totWR) ? "" : f_wrBar(totWR), text_color=totWRC, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_left)
    if not array.get(lxMergedArr, 3)
        array.set(lxMergedArr, 3, true)
        table.merge_cells(dailyStatsTable, 0, 0, 5, 0)

f_drawMonthly() =>
    int startTotalM = currentTotalM - statMonths + 1
    int[]   mWin    = array.new_int(statMonths, 0)
    int[]   mLoss   = array.new_int(statMonths, 0)
    float[] mNetR   = array.new_float(statMonths, 0.0)
    int[]   mMaxW   = array.new_int(statMonths, 0)
    int[]   mMaxL   = array.new_int(statMonths, 0)
    int[]   mStreak = array.new_int(statMonths, 0)
    if array.size(resIsWin) > 0
        for i = 0 to array.size(resIsWin) - 1
            int t = array.get(resTime, i)
            int idx = year(t, statsTz) * 12 + month(t, statsTz) - startTotalM
            if idx >= 0 and idx < statMonths
                bool isWin = array.get(resIsWin, i)
                int curStrk = array.get(mStreak, idx)
                if isWin
                    array.set(mWin, idx, array.get(mWin, idx) + 1)
                    curStrk := curStrk >= 0 ? curStrk + 1 : 1
                    array.set(mMaxW, idx, math.max(array.get(mMaxW, idx), curStrk))
                else
                    array.set(mLoss, idx, array.get(mLoss, idx) + 1)
                    curStrk := curStrk <= 0 ? curStrk - 1 : -1
                    array.set(mMaxL, idx, math.max(array.get(mMaxL, idx), -curStrk))
                array.set(mStreak, idx, curStrk)
                array.set(mNetR, idx, array.get(mNetR, idx) + array.get(resR, i))
    table.cell(monthlyStatsTable, 0, 0, "◆  MONTHLY  ·  Last " + str.tostring(statMonths) + " Months", text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    table.cell(monthlyStatsTable, 0, 1, "MONTH",  text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(monthlyStatsTable, 1, 1, "W-L",    text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(monthlyStatsTable, 2, 1, "WR%",    text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(monthlyStatsTable, 3, 1, "NET R",  text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(monthlyStatsTable, 4, 1, "STREAK", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    int bestMIdx = -1
    float bestMNR = 0.0
    for m = 0 to statMonths - 1
        if (array.get(mWin, m) + array.get(mLoss, m)) > 0 and array.get(mNetR, m) > bestMNR
            bestMNR := array.get(mNetR, m)
            bestMIdx := m
    float maxAbsM = 0.0
    for m = 0 to statMonths - 1
        maxAbsM := math.max(maxAbsM, math.abs(array.get(mNetR, m)))
    int mSumW = 0
    int mSumL = 0
    float mSumR = 0.0
    int allMaxW = 0
    int allMaxL = 0
    for m = 0 to statMonths - 1
        int totalM = startTotalM + m
        int mMon = (totalM - 1) % 12 + 1
        int mYr = (totalM - mMon) / 12
        string mLabel = f_monthShort(mMon) + " " + str.tostring(mYr)
        int mw = array.get(mWin, m)
        int ml = array.get(mLoss, m)
        float mnr = array.get(mNetR, m)
        int mtot = mw + ml
        float mwr = mtot > 0 ? (mw * 1.0 / mtot) * 100.0 : na
        color mwrC = na(mwr) ? lxDimTx : mwr >= 50 ? lxGreen : lxAmber
        bool isBestM = m == bestMIdx and mtot > 0
        // สีพื้นตามผลของเดือน: เขียว = กำไร / แดง = ขาดทุน ยิ่งมากยิ่งเข้ม (เทียบกับเดือนที่ผลสูงสุดในช่วงที่ดู)
        float heatK = maxAbsM > 0 ? math.min(1.0, math.abs(mnr) / maxAbsM) : 0.0
        color mRowBg = mtot == 0 ? lxRowDim : color.new(mnr >= 0 ? lxGreen : lxRed, int(88 - 50 * heatK))
        color mLabelC = isBestM ? lxTitleTx : mtot == 0 ? lxDimTx : lxText
        int mmxW = array.get(mMaxW, m)
        int mmxL = array.get(mMaxL, m)
        table.cell(monthlyStatsTable, 0, m + 2, (isBestM ? "★ " : "") + mLabel, text_color=mLabelC, text_size=size.small, bgcolor=mRowBg, text_halign=text.align_left)
        table.cell(monthlyStatsTable, 1, m + 2, mtot == 0 ? "-" : str.tostring(mw) + "W · " + str.tostring(ml) + "L", text_color=mtot == 0 ? lxDimTx : lxText, text_size=size.small, bgcolor=mRowBg)
        table.cell(monthlyStatsTable, 2, m + 2, na(mwr) ? "-" : str.tostring(mwr, "#.#") + "%", text_color=mwrC, text_size=size.small, bgcolor=mRowBg)
        table.cell(monthlyStatsTable, 3, m + 2, mtot == 0 ? "-" : f_rStr(mnr), text_color=f_posColor(mnr, mtot == 0), text_size=size.small, bgcolor=mRowBg, text_halign=text.align_right)
        table.cell(monthlyStatsTable, 4, m + 2, mtot == 0 ? "-" : "W" + str.tostring(mmxW) + " · L" + str.tostring(mmxL), text_color=mtot == 0 ? lxDimTx : lxAmber, text_size=size.small, bgcolor=mRowBg)
        mSumW += mw
        mSumL += ml
        mSumR += mnr
        allMaxW := math.max(allMaxW, mmxW)
        allMaxL := math.max(allMaxL, mmxL)
    int mSumTot = mSumW + mSumL
    float mSumWR = mSumTot > 0 ? (mSumW * 1.0 / mSumTot) * 100.0 : na
    color mSumWRC = na(mSumWR) ? lxDimTx : mSumWR >= 50 ? lxGreen : lxAmber
    int totalRow = statMonths + 2
    table.cell(monthlyStatsTable, 0, totalRow, "TOTAL", text_color=lxTitleTx, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_left)
    table.cell(monthlyStatsTable, 1, totalRow, mSumTot == 0 ? "-" : str.tostring(mSumW) + "W · " + str.tostring(mSumL) + "L", text_color=lxText, text_size=size.tiny, bgcolor=lxHeadBg)
    table.cell(monthlyStatsTable, 2, totalRow, na(mSumWR) ? "-" : str.tostring(mSumWR, "#.#") + "%", text_color=mSumWRC, text_size=size.tiny, bgcolor=lxHeadBg)
    table.cell(monthlyStatsTable, 3, totalRow, mSumTot == 0 ? "-" : f_rStr(mSumR), text_color=f_posColor(mSumR, mSumTot == 0), text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_right)
    table.cell(monthlyStatsTable, 4, totalRow, mSumTot == 0 ? "-" : "W" + str.tostring(allMaxW) + " · L" + str.tostring(allMaxL), text_color=mSumTot == 0 ? lxDimTx : lxAmber, text_size=size.tiny, bgcolor=lxHeadBg)
    if not array.get(lxMergedArr, 4)
        array.set(lxMergedArr, 4, true)
        table.merge_cells(monthlyStatsTable, 0, 0, 4, 0)

f_drawWeekday() =>
    int[]   wdWin  = array.new_int(8, 0)
    int[]   wdLoss = array.new_int(8, 0)
    float[] wdNetR = array.new_float(8, 0.0)
    int     runLen = 0
    int[]   runDays  = array.new_int(8, 0)
    int     maxWLen = 0
    int     maxLLen = 0
    int[]   maxWDays = array.new_int(8, 0)
    int[]   maxLDays = array.new_int(8, 0)
    if array.size(resIsWin) > 0
        for i = 0 to array.size(resIsWin) - 1
            int t = array.get(resTime, i)
            if f_inPeriod(t)
                int dow = dayofweek(t, statsTz)
                bool isWin = array.get(resIsWin, i)
                if isWin
                    array.set(wdWin, dow, array.get(wdWin, dow) + 1)
                    if runLen >= 0
                        runLen += 1
                    else
                        runLen := 1
                        array.fill(runDays, 0)
                    array.set(runDays, dow, array.get(runDays, dow) + 1)
                    if runLen > maxWLen
                        maxWLen := runLen
                        maxWDays := array.copy(runDays)
                else
                    array.set(wdLoss, dow, array.get(wdLoss, dow) + 1)
                    if runLen <= 0
                        runLen -= 1
                    else
                        runLen := -1
                        array.fill(runDays, 0)
                    array.set(runDays, dow, array.get(runDays, dow) + 1)
                    if -runLen > maxLLen
                        maxLLen := -runLen
                        maxLDays := array.copy(runDays)
                array.set(wdNetR, dow, array.get(wdNetR, dow) + array.get(resR, i))
    string wdPeriod = isDayMode ? (str.format_time(dayModeTs, "dd MMM yyyy", statsTz)) : statMode == "1. ย้อนหลังตามจำนวนวัน (Days)" ? ("Last " + str.tostring(statDays) + "d") : statMode == "2. ย้อนหลังตามจำนวนเดือน (Months)" ? ("Last " + str.tostring(statMonths) + "mo") : (statTargetM + " " + str.tostring(actualTargetY))
    table.cell(weekdayStatsTable, 0, 0, "◆  BY WEEKDAY  ·  " + wdPeriod, text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    for c = 1 to 5
        table.cell(weekdayStatsTable, c, 0, "", text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    table.cell(weekdayStatsTable, 0, 1, "DAY",   text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg, text_halign=text.align_left)
    table.cell(weekdayStatsTable, 1, 1, "W-L",   text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(weekdayStatsTable, 2, 1, "WR%",   text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(weekdayStatsTable, 3, 1, "NET R", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(weekdayStatsTable, 4, 1, "inW" + str.tostring(maxWLen), text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    table.cell(weekdayStatsTable, 5, 1, "inL" + str.tostring(maxLLen), text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    int worstIdx = -1
    float worstNR = 0.0
    int hotLIdx = -1
    int hotLVal = 0
    for d = 1 to 7
        if (array.get(wdWin, d) + array.get(wdLoss, d)) > 0 and array.get(wdNetR, d) < worstNR
            worstNR := array.get(wdNetR, d)
            worstIdx := d
        if array.get(maxLDays, d) > hotLVal
            hotLVal := array.get(maxLDays, d)
            hotLIdx := d
    string[] wdNames = array.from("", "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat")
    int wdSumW = 0
    int wdSumL = 0
    float wdSumR = 0.0
    for d = 1 to 7
        int w = array.get(wdWin, d)
        int l = array.get(wdLoss, d)
        float nr = array.get(wdNetR, d)
        int inW = array.get(maxWDays, d)
        int inL = array.get(maxLDays, d)
        int tot = w + l
        float wr = tot > 0 ? (w * 1.0 / tot) * 100.0 : na
        color wrC = na(wr) ? lxDimTx : wr >= 50 ? lxGreen : lxAmber
        bool isHotL = d == hotLIdx and inL > 0
        bool isWorst = d == worstIdx
        color rowBg = isWorst ? color.new(color.red, 75) : d % 2 == 0 ? lxRowA : lxRowB
        color labC = isWorst ? lxRed : tot == 0 ? lxDimTx : lxText
        table.cell(weekdayStatsTable, 0, d + 1, (isWorst ? "⚠ " : "") + array.get(wdNames, d), text_color=labC, text_size=size.small, bgcolor=rowBg, text_halign=text.align_left)
        table.cell(weekdayStatsTable, 1, d + 1, tot == 0 ? "-" : str.tostring(w) + "W · " + str.tostring(l) + "L", text_color=tot == 0 ? lxDimTx : lxText, text_size=size.small, bgcolor=rowBg)
        table.cell(weekdayStatsTable, 2, d + 1, na(wr) ? "-" : str.tostring(wr, "#.#") + "%", text_color=wrC, text_size=size.small, bgcolor=rowBg)
        table.cell(weekdayStatsTable, 3, d + 1, tot == 0 ? "-" : f_rStr(nr), text_color=f_posColor(nr, tot == 0), text_size=size.small, bgcolor=rowBg, text_halign=text.align_right)
        table.cell(weekdayStatsTable, 4, d + 1, inW > 0 ? str.tostring(inW) : "·", text_color=inW > 0 ? lxGreen : lxDimTx, text_size=size.small, bgcolor=rowBg)
        table.cell(weekdayStatsTable, 5, d + 1, inL > 0 ? ((isHotL ? "🔥" : "") + str.tostring(inL)) : "·", text_color=inL > 0 ? lxRed : lxDimTx, text_size=size.small, bgcolor=rowBg)
        wdSumW += w
        wdSumL += l
        wdSumR += nr
    int wdSumTot = wdSumW + wdSumL
    float wdSumWR = wdSumTot > 0 ? (wdSumW * 1.0 / wdSumTot) * 100.0 : na
    color wdSumWRC = na(wdSumWR) ? lxDimTx : wdSumWR >= 50 ? lxGreen : lxAmber
    table.cell(weekdayStatsTable, 0, 9, "TOTAL", text_color=lxTitleTx, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_left)
    table.cell(weekdayStatsTable, 1, 9, wdSumTot == 0 ? "-" : str.tostring(wdSumW) + "W · " + str.tostring(wdSumL) + "L", text_color=lxText, text_size=size.tiny, bgcolor=lxHeadBg)
    table.cell(weekdayStatsTable, 2, 9, na(wdSumWR) ? "-" : str.tostring(wdSumWR, "#.#") + "%", text_color=wdSumWRC, text_size=size.tiny, bgcolor=lxHeadBg)
    table.cell(weekdayStatsTable, 3, 9, wdSumTot == 0 ? "-" : f_rStr(wdSumR), text_color=f_posColor(wdSumR, wdSumTot == 0), text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_right)
    table.cell(weekdayStatsTable, 4, 9, "=" + str.tostring(maxWLen), text_color=wdSumTot == 0 ? lxDimTx : lxGreen, text_size=size.tiny, bgcolor=lxHeadBg)
    table.cell(weekdayStatsTable, 5, 9, "=" + str.tostring(maxLLen), text_color=wdSumTot == 0 ? lxDimTx : lxRed, text_size=size.tiny, bgcolor=lxHeadBg)
    if not array.get(lxMergedArr, 7)
        array.set(lxMergedArr, 7, true)
        table.merge_cells(weekdayStatsTable, 0, 0, 5, 0)

f_drawSettings() =>
    table.cell(settingsTable, 0, 0, "◆  SETTINGS SUMMARY", text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    table.cell(settingsTable, 1, 0, "", text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    string[] k = array.from("Compare with", "Tolerance", "Buy", "Sell", "Exit rule", "1R Basis", "Stats TZ")
    string[] v = array.from(prevMode, str.tostring(tol, "#.##"), allowLong ? "ON" : "OFF", allowShort ? "ON" : "OFF", (isOpp ? "Opposite brick" : isSLTP ? ("TP " + str.tostring(tpPts) + " / SL " + str.tostring(slPts)) : str.tostring(exitN) + " same-color"), "2 boxes", statsTz)
    for i = 0 to 6
        color rb = i % 2 == 0 ? lxRowA : lxRowB
        table.cell(settingsTable, 0, i + 1, array.get(k, i), text_color=lxMuted, text_size=size.tiny, bgcolor=rb, text_halign=text.align_left)
        table.cell(settingsTable, 1, i + 1, array.get(v, i), text_color=lxText, text_size=size.tiny, bgcolor=rb, text_halign=text.align_right)
    if not array.get(lxMergedArr, 5)
        array.set(lxMergedArr, 5, true)
        table.merge_cells(settingsTable, 0, 0, 1, 0)

// จำนวนออเดอร์ที่ปิดแล้วของวันที่ดู และจำนวนออเดอร์ที่ยังเปิดอยู่ (เข้าวันที่ดู, สูงสุด 3 แถว)
f_dayClosedCount() =>
    int c = 0
    int n = array.size(resIsWin)
    if n > 0
        for i = 0 to n - 1
            if f_dayId(array.get(resTime, i)) == dayModeId
                c += 1
    c

f_dayOpenCount() =>
    int c = 0
    int nO = array.size(oPx)
    if nO > 0
        for j = 0 to math.min(nO, 3) - 1
            if f_dayId(array.get(oTime, j)) == dayModeId
                c += 1
    c

// ตารางรายออเดอร์ของวันนี้/วันที่เลือก (เรียงตามเวลาเข้า) + ออเดอร์ที่ยังเปิดอยู่ + สรุป
// tbl ถูกสร้างใหม่ก่อนเรียก (ขนาด rowsTotal แถว) / shown = จำนวนออเดอร์ที่ปิดแล้วที่จะแสดง (ล่าสุด)
f_drawToday(table tbl, int shown, int rowsTotal) =>
    int[] idx = array.new_int()
    int n = array.size(resIsWin)
    if n > 0
        for i = 0 to n - 1
            if f_dayId(array.get(resTime, i)) == dayModeId
                array.push(idx, i)
    int cnt = array.size(idx)
    int first = cnt - shown
    float sumR = 0.0
    float sumPts = 0.0
    int wCnt = 0
    int lCnt = 0
    if cnt > 0
        for k = 0 to cnt - 1
            int i = array.get(idx, k)
            sumR += array.get(resR, i)
            sumPts += array.get(resPts, i)
            if array.get(resIsWin, i)
                wCnt += 1
            else
                lCnt += 1
    table.cell(tbl, 0, 0, "◆  TRADES  ·  " + str.format_time(dayModeTs, "dd MMM yyyy", statsTz) + "  ·  " + str.tostring(cnt) + " closed" + (cnt > shown ? "  (latest " + str.tostring(shown) + ")" : ""), text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    for c = 1 to 7
        table.cell(tbl, c, 0, "", text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    table.merge_cells(tbl, 0, 0, 7, 0)
    string[] hd = array.from("#", "SIDE", "IN", "OUT", "ENTRY", "EXIT", "PTS", "R")
    for c = 0 to 7
        table.cell(tbl, c, 1, array.get(hd, c), text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg)
    int row = 2
    if cnt == 0 and array.size(oPx) == 0
        table.cell(tbl, 0, row, "ไม่มีออเดอร์ในวันที่ดู", text_color=lxDimTx, text_size=size.tiny, bgcolor=lxRowA, text_halign=text.align_left)
    if shown > 0
        for k = first to cnt - 1
            int i = array.get(idx, k)
            bool isBuy = array.get(resIsBuy, i)
            bool win = array.get(resIsWin, i)
            float pts = array.get(resPts, i)
            float rr = array.get(resR, i)
            color bg = row % 2 == 0 ? lxRowA : lxRowB
            color rc = win ? lxGreen : lxRed
            table.cell(tbl, 0, row, str.tostring(k + 1), text_color=lxMuted, text_size=size.tiny, bgcolor=bg)
            table.cell(tbl, 1, row, isBuy ? "BUY" : "SELL", text_color=isBuy ? lxGreen : lxRed, text_size=size.tiny, bgcolor=bg)
            table.cell(tbl, 2, row, str.format_time(array.get(resTime, i), "HH:mm:ss", statsTz), text_color=lxText, text_size=size.tiny, bgcolor=bg)
            table.cell(tbl, 3, row, str.format_time(array.get(resExitTime, i), "HH:mm:ss", statsTz), text_color=lxText, text_size=size.tiny, bgcolor=bg)
            table.cell(tbl, 4, row, str.tostring(array.get(resEntryPx, i), format.mintick), text_color=lxText, text_size=size.tiny, bgcolor=bg, text_halign=text.align_right)
            table.cell(tbl, 5, row, str.tostring(array.get(resExitPx, i), format.mintick), text_color=lxText, text_size=size.tiny, bgcolor=bg, text_halign=text.align_right)
            table.cell(tbl, 6, row, (pts >= 0 ? "+" : "") + str.tostring(pts, "#.##"), text_color=rc, text_size=size.tiny, bgcolor=bg, text_halign=text.align_right)
            table.cell(tbl, 7, row, f_rStr(rr), text_color=rc, text_size=size.tiny, bgcolor=bg, text_halign=text.align_right)
            row += 1
    // ออเดอร์ที่ยังเปิดอยู่ (เข้าวันที่ดู) แสดงกำไร/ขาดทุนลอยตัวที่ราคาปัจจุบัน
    int nOpen = array.size(oPx)
    if nOpen > 0
        for j = 0 to math.min(nOpen, 3) - 1
            if f_dayId(array.get(oTime, j)) == dayModeId
                float ep = array.get(oPx, j)
                float fl = pos == 1 ? close - ep : ep - close
                float flR = fl / array.get(oRisk, j)
                color oc = fl >= 0 ? lxGreen : lxRed
                table.cell(tbl, 0, row, "▶", text_color=lxAmber, text_size=size.tiny, bgcolor=lxHeadBg)
                table.cell(tbl, 1, row, pos == 1 ? "BUY" : "SELL", text_color=pos == 1 ? lxGreen : lxRed, text_size=size.tiny, bgcolor=lxHeadBg)
                table.cell(tbl, 2, row, str.format_time(array.get(oTime, j), "HH:mm:ss", statsTz), text_color=lxText, text_size=size.tiny, bgcolor=lxHeadBg)
                table.cell(tbl, 3, row, "OPEN", text_color=lxAmber, text_size=size.tiny, bgcolor=lxHeadBg)
                table.cell(tbl, 4, row, str.tostring(ep, format.mintick), text_color=lxText, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_right)
                table.cell(tbl, 5, row, str.tostring(close, format.mintick), text_color=lxText, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_right)
                table.cell(tbl, 6, row, (fl >= 0 ? "+" : "") + str.tostring(fl, "#.##"), text_color=oc, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_right)
                table.cell(tbl, 7, row, f_rStr(flR), text_color=oc, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_right)
                row += 1
    int totRow = rowsTotal - 1
    color totC = f_posColor(sumR, cnt == 0)
    table.cell(tbl, 0, totRow, "TOTAL", text_color=lxTitleTx, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_left)
    table.cell(tbl, 1, totRow, cnt == 0 ? "-" : str.tostring(wCnt) + "W·" + str.tostring(lCnt) + "L", text_color=lxText, text_size=size.tiny, bgcolor=lxHeadBg)
    for c = 2 to 5
        table.cell(tbl, c, totRow, "", text_color=lxText, text_size=size.tiny, bgcolor=lxHeadBg)
    table.cell(tbl, 6, totRow, cnt == 0 ? "-" : (sumPts >= 0 ? "+" : "") + str.tostring(sumPts, "#.##"), text_color=totC, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_right)
    table.cell(tbl, 7, totRow, cnt == 0 ? "-" : f_rStr(sumR), text_color=totC, text_size=size.tiny, bgcolor=lxHeadBg, text_halign=text.align_right)

// ==========================================
// --- 5B. PATTERN OUTLOOK (คาดการณ์ pattern ของ brick ที่กำลังก่อตัว) ---
// ==========================================
// ประเมิน "ถ้า brick ถัดไป (ที่กำลังก่อตัว) ปิดเป็นขึ้น/ลง" ว่าเงื่อนไขของทุก Entry เป็นจริงไหม (ไม่ขึ้นกับ Entry mode ที่เลือก)
// ใช้สูตรเดียวกับสัญญาณจริงด้านบน แต่อ่านประวัติจากอาร์เรย์ brick ที่ปิดแล้ว (index 0 = brick ล่าสุดที่ปิด = [1] ของสูตรจริง)
// และแทนแท่งปัจจุบันด้วย brick สมมติ (hO/hH/hL/hC) ทำงานได้ทั้งตอนตลาดเปิดและปิด (ตลาดปิดจะประเมินจาก brick ล่าสุดที่ปิด)
f_has(int i) => i >= 0 and array.size(cBull) > i
f_bu(int i)  => f_has(i) and array.get(cBull, i)
f_be(int i)  => f_has(i) and not array.get(cBull, i)
f_hi(int i)  => f_has(i) ? array.get(cHigh, i) : na
f_lo(int i)  => f_has(i) ? array.get(cLow, i) : na
f_red(int i) => f_has(i) ? array.get(cRed, i) : 0
f_grn(int i) => f_has(i) ? array.get(cGrn, i) : 0
f_nw(int i)  => f_has(i) and array.get(cNW, i)

// brick ล่าสุด "สีเดียวกับ brick สมมติ" ที่ใช้เทียบแบบ Engulf (Immediate previous = แท่งก่อนหน้าทันทีถ้าสีเดียวกัน / Last Bull/Bear = แท่งสีนั้นล่าสุด)
f_refIdx(bool up) =>
    int found = -1
    if prevMode == "Last Bull/Bear"
        for k = 0 to array.size(cBull) - 1
            if found < 0 and array.get(cBull, k) == up
                found := k
    else if f_has(0) and array.get(cBull, 0) == up
        found := 0
    found

// ผลลัพธ์เรียง: Engulf, Reversal, NoWick, W&M, Reverse Engulf, Double, FollowTrend, RevEngulf02, RGR
// (brick ขึ้น = BUY / brick ลง = SELL ทุก pattern)
f_outlookFlags(bool up, float hO, float hH, float hL, float hC) =>
    int  gg   = up ? f_grn(0) + 1 : 0
    int  rr   = up ? 0 : f_red(0) + 1
    int  opp  = up ? f_red(0) : f_grn(0)
    bool nwk  = hH - math.max(hO, hC) <= nwTol + syminfo.mintick * 0.5 and math.min(hO, hC) - hL <= nwTol + syminfo.mintick * 0.5
    int  ri   = f_refIdx(up)
    bool fEngulf = ri >= 0 and hH >= f_hi(ri) - tol and hL <= f_lo(ri) + tol
    bool fRev    = opp >= revMin and hH > f_hi(0) and hL < f_lo(0)
    bool fNW     = nwk and f_nw(0) and opp >= nwMin
    bool fPat    = up ? (f_be(0) and f_bu(1) and f_be(2) and f_grn(3) >= patMin) : (f_bu(0) and f_be(1) and f_bu(2) and f_red(3) >= patMin)
    bool covPx   = f_hi(1) >= f_hi(2) - tol and f_lo(1) <= f_lo(2) + tol
    bool fCov    = up ? (f_bu(0) and f_be(1) and f_bu(2) and covPx) : (f_be(0) and f_bu(1) and f_be(2) and covPx)
    bool fDbl    = up ? (gg == 3 and f_red(2) == 2 and f_grn(4) == 2 and f_red(6) >= 3) : (rr == 3 and f_grn(2) == 2 and f_red(4) == 2 and f_grn(6) >= 3)
    bool fFT     = up ? (gg == 1 and f_red(0) == 1 and f_grn(1) == 1 and f_red(2) == 2 and f_grn(4) >= 3) : (rr == 1 and f_grn(0) == 1 and f_red(1) == 1 and f_grn(2) == 2 and f_red(4) >= 3)
    bool re2Px   = f_hi(0) >= f_hi(1) - tol and f_lo(0) <= f_lo(1) + tol
    bool fRE2    = up ? (f_be(0) and f_be(1) and f_nw(1) and re2Px and hL < f_lo(0)) : (f_bu(0) and f_bu(1) and f_nw(1) and re2Px and hH > f_hi(0))
    bool fRGR    = up ? (f_be(0) and f_bu(1)) : (f_bu(0) and f_be(1))   // up: เขียว>แดง>เขียว = BUY / down: แดง>เขียว>แดง = SELL
    array.from(fEngulf, fRev, fNW, fPat, fCov, fDbl, fFT, fRE2, fRGR)

f_drawOutlook() =>
    bool hasHist = array.size(cBull) >= 8
    bool live    = barstate.isrealtime and not barstate.isconfirmed
    string tag   = live ? "LIVE " + str.format_time(timenow, "HH:mm:ss", statsTz) : "CLOSED"
    table.cell(outlookTbl, 0, 0, "◆ OUTLOOK · brick ถัดไป", text_color=lxTitleTx, text_size=size.small, bgcolor=lxHeadBg)
    if not hasHist
        table.cell(outlookTbl, 0, 1, "รอ brick ≥ 8", text_color=lxMuted, text_size=size.tiny, bgcolor=lxSubBg, text_halign=text.align_left)
    else
        // brick ล่าสุดที่ปิด (index 0) กำหนดระดับที่ brick ถัดไปจะปิด: ต่อเนื่องจาก close / กลับทิศต้องผ่านจุดเปิดของ brick นั้น (= 2 box จาก close)
        float lc    = array.get(cClose, 0)
        float lo0   = array.get(cOpen, 0)
        float bx    = math.max(math.abs(lc - lo0), syminfo.mintick)
        bool  lastUp = lc > lo0
        float upO   = lastUp ? lc : lo0
        float upC   = upO + bx
        float dnO   = lastUp ? lo0 : lc
        float dnC   = dnO - bx
        float px    = live ? close : lc
        float dUp   = math.max(upC - px, syminfo.mintick)
        float dDn   = math.max(px - dnC, syminfo.mintick)
        float pUp   = dDn / (dUp + dDn) * 100.0   // โอกาสแตะระดับขึ้นก่อน (random walk ไม่มีทิศ: สัดส่วนกลับกับระยะ)
        float pDn   = 100.0 - pUp
        // ไส้ของ brick สมมติ: ตอนสด ใช้ high/low ของแท่งที่กำลังก่อตัว / ตอนตลาดปิดไม่รู้ จึงถือว่าไม่มีไส้
        float upL   = live ? math.min(upO, low) : upO
        float dnH   = live ? math.max(dnO, high) : dnO
        array<bool> fUp = f_outlookFlags(true,  upO, upC, upL, upC)
        array<bool> fDn = f_outlookFlags(false, dnO, dnH, dnC, dnC)
        array<string> nm  = array.from("Engulf", "Reversal", "NoWick", "W&M", "Rev.Engulf", "Double", "FollowTr.", "RevEng02", "RGR")
        array<bool>   sel = array.from(useEngulf, useRev, useNW, usePat, useCover, useDbl, useFT, useRE2, useRGR)
        table.cell(outlookTbl, 0, 1, tag + " · " + str.tostring(px, format.mintick), text_color=live ? lxCyan : lxMuted, text_size=size.tiny, bgcolor=lxSubBg, text_halign=text.align_left)
        table.cell(outlookTbl, 0, 2, "▲ Up", text_color=lxGreen, text_size=size.small, bgcolor=lxRowA, text_halign=text.align_left)
        table.cell(outlookTbl, 1, 2, str.tostring(upC, format.mintick), text_color=lxText, text_size=size.small, bgcolor=lxRowA, text_halign=text.align_center)
        table.cell(outlookTbl, 2, 2, "+" + str.tostring(dUp, format.mintick), text_color=lxMuted, text_size=size.small, bgcolor=lxRowA, text_halign=text.align_center)
        table.cell(outlookTbl, 3, 2, str.tostring(pUp, "#") + "%", text_color=lxGreen, text_size=size.small, bgcolor=lxRowA, text_halign=text.align_center)
        table.cell(outlookTbl, 0, 3, "▼ Down", text_color=lxRed, text_size=size.small, bgcolor=lxRowB, text_halign=text.align_left)
        table.cell(outlookTbl, 1, 3, str.tostring(dnC, format.mintick), text_color=lxText, text_size=size.small, bgcolor=lxRowB, text_halign=text.align_center)
        table.cell(outlookTbl, 2, 3, "-" + str.tostring(dDn, format.mintick), text_color=lxMuted, text_size=size.small, bgcolor=lxRowB, text_halign=text.align_center)
        table.cell(outlookTbl, 3, 3, str.tostring(pDn, "#") + "%", text_color=lxRed, text_size=size.small, bgcolor=lxRowB, text_halign=text.align_center)
        table.cell(outlookTbl, 0, 4, "PATTERN", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg, text_halign=text.align_left)
        table.cell(outlookTbl, 1, 4, "▲ Up", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg, text_halign=text.align_center)
        table.cell(outlookTbl, 2, 4, "▼ Down", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg, text_halign=text.align_center)
        table.cell(outlookTbl, 3, 4, "%", text_color=lxColHd, text_size=size.tiny, bgcolor=lxSubBg, text_halign=text.align_center)
        int nUp = 0
        int nDn = 0
        for k = 0 to 8
            bool u = array.get(fUp, k)
            bool d = array.get(fDn, k)
            bool sk = array.get(sel, k)
            bool upBuy = true     // brick ขึ้น = BUY
            bool dnBuy = false    // brick ลง = SELL
            float pat = (u ? pUp : 0.0) + (d ? pDn : 0.0)   // โอกาสที่ pattern นี้เกิด ณ ราคาตอนนี้ (รวมทั้งสองทิศถ้าเกิดได้ทั้งคู่)
            color rowBg = k % 2 == 0 ? lxRowA : lxRowB
            color hiBg  = pat > 0 ? color.new(u and d ? lxAmber : ((u and upBuy) or (d and dnBuy)) ? lxGreen : lxRed, 86) : rowBg
            nUp += u ? 1 : 0
            nDn += d ? 1 : 0
            table.cell(outlookTbl, 0, 5 + k, (sk ? "●" : "○") + array.get(nm, k), text_color=pat > 0 ? lxText : (sk ? lxText : lxMuted), text_size=size.tiny, bgcolor=hiBg, text_halign=text.align_left)
            table.cell(outlookTbl, 1, 5 + k, u ? (upBuy ? "BUY" : "SELL") : "·", text_color=u ? (upBuy ? lxGreen : lxRed) : lxDimTx, text_size=size.tiny, bgcolor=hiBg, text_halign=text.align_center)
            table.cell(outlookTbl, 2, 5 + k, d ? (dnBuy ? "BUY" : "SELL") : "·", text_color=d ? (dnBuy ? lxGreen : lxRed) : lxDimTx, text_size=size.tiny, bgcolor=hiBg, text_halign=text.align_center)
            table.cell(outlookTbl, 3, 5 + k, pat > 0 ? str.tostring(pat, "#") + "%" : "-", text_color=pat > 0 ? lxText : lxDimTx, text_size=size.tiny, bgcolor=hiBg, text_halign=text.align_center)
        table.cell(outlookTbl, 0, 14, "รวม", text_color=lxMuted, text_size=size.tiny, bgcolor=lxSubBg, text_halign=text.align_left)
        table.cell(outlookTbl, 1, 14, str.tostring(nUp), text_color=nUp > 0 ? lxText : lxDimTx, text_size=size.tiny, bgcolor=lxSubBg, text_halign=text.align_center)
        table.cell(outlookTbl, 2, 14, str.tostring(nDn), text_color=nDn > 0 ? lxText : lxDimTx, text_size=size.tiny, bgcolor=lxSubBg, text_halign=text.align_center)
        table.cell(outlookTbl, 3, 14, "", text_color=lxDimTx, text_size=size.tiny, bgcolor=lxSubBg)
        table.cell(outlookTbl, 0, 15, "● = เลือกอยู่ · % ประมาณจากระยะราคา", text_color=lxDimTx, text_size=size.tiny, bgcolor=lxRowDim, text_halign=text.align_left)
    if not array.get(lxMergedArr, 6)
        array.set(lxMergedArr, 6, true)
        table.merge_cells(outlookTbl, 0, 0, 3, 0)
        table.merge_cells(outlookTbl, 0, 1, 3, 1)
        table.merge_cells(outlookTbl, 0, 15, 3, 15)

// ==========================================
// --- 6. DRAW TABLES (last bar only) ---
// ==========================================
if showStatsTable and barstate.islast
    f_drawStats()
if showOutlook and barstate.islast
    f_drawOutlook()
if showDailyTable and barstate.islast
    f_drawDaily()
if showMonthlyTable and barstate.islast and statMode == "2. ย้อนหลังตามจำนวนเดือน (Months)"
    f_drawMonthly()
if showWeekdayTable and barstate.islast
    f_drawWeekday()
if showSettingsTable and barstate.islast
    f_drawSettings()
if (showTodayTable or isDayMode) and barstate.islast
    int tCnt  = f_dayClosedCount()
    int tOpen = f_dayOpenCount()
    int tShow = math.min(todayMaxRows == 0 ? tCnt : math.min(todayMaxRows, tCnt), 95)   // 0 = ทั้งหมด (จำกัด 95 แถว)
    int tRows = 3 + math.max(tShow + tOpen, 1)                                          // หัว + หัวคอลัมน์ + แถวข้อมูล + TOTAL
    if not na(todayTbl)
        table.delete(todayTbl)
    todayTbl := table.new(f_tablePos(todayTablePosStr), 8, tRows, bgcolor=lxRowA, frame_width=2, frame_color=lxFrame, border_width=1, border_color=lxGrid)
    f_drawToday(todayTbl, tShow, tRows)

// ==========================================
// --- 7. เส้นแนวตั้ง High–Low ของ brick ที่ "กำลังก่อตัว" (ช่องถัดจากแท่งล่าสุด) ---
// ==========================================
// บนกราฟ Renko ของ TV แท่งล่าสุดคือ brick ที่ปิดแล้ว ส่วน brick ถัดไปที่ยังไม่เกิดไม่มีข้อมูลในสคริปต์
// จึงอ่านราคาจาก "กราฟปกติ" (ticker.standard) ของสัญลักษณ์เดียวกัน แล้วเก็บยอดสูง/ต่ำสุดตั้งแต่ brick ล่าสุดปิด
// (varip = ค่าคงอยู่ข้าม tick) เริ่มนับใหม่ทุกครั้งที่ brick ใหม่เกิด — ไม่นับ High/Low ของ brick ที่ปิดไปแล้ว
[livePx, liveH, liveL] = request.security(ticker.standard(syminfo.tickerid), timeframe.period, [close, high, low])
varip float tkHi = na
varip float tkLo = na
varip int   tkN  = 0          // จำนวนครั้งที่สคริปต์รันตั้งแต่ brick ล่าสุดปิด (ใช้ตรวจว่า TV รันสคริปต์ระหว่าง brick หรือไม่)
if not na(livePx)
    if barstate.isnew or na(tkHi)
        tkHi := livePx
        tkLo := livePx
        tkN  := 1
    else
        tkHi := math.max(tkHi, livePx)
        tkLo := math.min(tkLo, livePx)
        tkN  += 1

var line  tkLine = na
var line  tkCapH = na
var line  tkCapL = na
var line  tkPx   = na
var line  tkBase = na
var label tkLblH = na
var label tkLblL = na
var label tkLblT = na
var table dbgTbl = table.new(position.top_center, 2, 7, bgcolor=color.new(#0d111c, 10), border_color=color.new(color.gray, 60), border_width=1, frame_color=color.new(#fbbf24, 40), frame_width=2)
if showTickLine and barstate.islast and not na(tkHi)
    line.delete(tkLine)
    line.delete(tkCapH)
    line.delete(tkCapL)
    line.delete(tkPx)
    line.delete(tkBase)
    label.delete(tkLblH)
    label.delete(tkLblL)
    label.delete(tkLblT)
    int xN = bar_index + 2     // ช่องของ brick ถัดไป (เว้น 1 ช่องจากแท่งล่าสุด)
    float hiShow = math.max(tkHi, close)   // close = ราคาปิดของ brick ล่าสุด: จุดเริ่มของ brick ที่กำลังก่อตัว
    float loShow = math.min(tkLo, close)
    // จุดเริ่ม: ราคาปิดของ brick ล่าสุด (เส้นประเชื่อมไปยังเส้นแนวตั้ง)
    tkBase := line.new(bar_index, close, xN, close, color=color.new(colTick, 40), style=line.style_dotted, width=1)
    tkLine := line.new(xN, loShow, xN, hiShow, color=colTick, width=3)
    tkCapH := line.new(xN - 1, hiShow, xN + 1, hiShow, color=colTick, width=3)
    tkCapL := line.new(xN - 1, loShow, xN + 1, loShow, color=colTick, width=3)
    tkPx   := line.new(xN - 1, livePx, xN + 1, livePx, color=color.white, width=2)
    tkLblH := label.new(xN + 1, hiShow, "H " + str.tostring(hiShow, format.mintick), style=label.style_label_right, color=color.new(colTick, 60), textcolor=color.white, size=size.small)
    tkLblL := label.new(xN + 1, loShow, "L " + str.tostring(loShow, format.mintick) + "  range " + str.tostring(hiShow - loShow, format.mintick), style=label.style_label_right, color=color.new(colTick, 60), textcolor=color.white, size=size.small)
    tkLblT := label.new(xN - 1, livePx, "now " + str.tostring(livePx, format.mintick), style=label.style_label_left, color=color.new(color.gray, 40), textcolor=color.white, size=size.tiny)
    // ตารางตรวจสอบ: ดูว่าสคริปต์ได้ราคาสดจากกราฟปกติหรือไม่ และรันกี่ครั้งตั้งแต่ brick ล่าสุดปิด
    table.cell(dbgTbl, 0, 0, "◆ brick ที่กำลังก่อตัว (ตรวจสอบ)", text_color=color.rgb(236, 210, 140), text_size=size.small, bgcolor=color.new(color.rgb(26, 32, 52), 6))
    table.cell(dbgTbl, 1, 0, "", text_color=color.white, text_size=size.small, bgcolor=color.new(color.rgb(26, 32, 52), 6))
    string[] dk = array.from("ปิดของ brick ล่าสุด", "ราคาสดจากกราฟปกติ", "High ตั้งแต่ brick ปิด", "Low ตั้งแต่ brick ปิด", "range", "สคริปต์รันกี่ครั้งแล้ว")
    string[] dv = array.from(str.tostring(close, format.mintick), str.tostring(livePx, format.mintick), str.tostring(tkHi, format.mintick), str.tostring(tkLo, format.mintick), str.tostring(tkHi - tkLo, format.mintick), str.tostring(tkN))
    for i = 0 to 5
        table.cell(dbgTbl, 0, i + 1, array.get(dk, i), text_color=color.gray, text_size=size.tiny, text_halign=text.align_left, bgcolor=color.new(color.rgb(13, 17, 28), 14))
        table.cell(dbgTbl, 1, i + 1, array.get(dv, i), text_color=color.white, text_size=size.tiny, text_halign=text.align_right, bgcolor=color.new(color.rgb(13, 17, 28), 14))
    table.merge_cells(dbgTbl, 0, 0, 1, 0)
